<%# i18n (5.0.0). `t`/`pageTitle`/`locale` come from res.locals (session
    middleware). The fallbacks keep standalone rendering working (harnesses that
    render a template without the middleware) — they must never throw. %>
<% const tr = (typeof t === 'function') ? t : function (k) { return k; }; %>
<% const pt = (typeof pageTitle === 'function') ? pageTitle : function (x) { return x; }; %>
<% const loc = (typeof locale === 'string' && locale) ? locale : 'en'; %>
<% const csrf = (typeof csrfToken !== 'undefined' && csrfToken) ? csrfToken : ''; %>
<!DOCTYPE html>
<html lang="<%= loc %>">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= pt(title) %> - <%= tr('common.adminTitle') %></title>
<link rel="stylesheet" href="/css/admin.css">
</head>
<body>
<div class="admin-layout">
<aside class="sidebar">
<div class="sidebar-header">
<h2 style="display:flex;align-items:center;gap:8px;">
<span style="display:inline-flex;align-items:center;gap:8px;font-weight:800;font-size:22px;letter-spacing:-0.5px;"><span style="display:inline-flex;align-items:center;justify-content:center;width:38px;height:38px;background:linear-gradient(135deg,#10b981,#059669);border-radius:8px;color:#fff;font-size:18px;font-weight:900;line-height:1;">S</span><span>Status<span style="color:#10b981;">Fe</span></span></span>
</h2>
<span class="sidebar-subtitle"><%= tr('nav.adminPanel') %> <a href="/admin/customize" style="color:#10b981;text-decoration:none;margin-left:4px;font-size:13px;"><%= tr('nav.customize') %></a></span>
<form class="locale-switch" method="post" action="/admin/locale" aria-label="<%= tr('nav.language') %>" style="display:flex;gap:6px;margin-top:10px;">
<input type="hidden" name="_csrf" value="<%= csrf %>">
<button type="submit" name="locale" value="en" title="<%= tr('nav.langEnTitle') %>" style="flex:1;padding:3px 0;font-size:11px;font-weight:700;border-radius:6px;border:1px solid rgba(255,255,255,.2);cursor:pointer;<%= loc === 'en' ? 'background:#10b981;color:#fff;' : 'background:transparent;color:inherit;' %>"><%= tr('nav.langEn') %></button>
<button type="submit" name="locale" value="es" title="<%= tr('nav.langEsTitle') %>" style="flex:1;padding:3px 0;font-size:11px;font-weight:700;border-radius:6px;border:1px solid rgba(255,255,255,.2);cursor:pointer;<%= loc === 'es' ? 'background:#10b981;color:#fff;' : 'background:transparent;color:inherit;' %>"><%= tr('nav.langEs') %></button>
</form>
</div>
<nav class="sidebar-nav">
<a href="/admin" class="<%= title === 'Dashboard' ? 'active' : '' %>">
<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
<%= tr('nav.dashboard') %>
</a>
<a href="/admin/pages" class="<%= title === 'Pages' ? 'active' : '' %>">
<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/></svg>
<%= tr('nav.pages') %>
</a>
<!-- Components with Dependencies submenu -->
<a href="javascript:void(0)" class="sidebar-parent <%= ['Components','Dependencies'].includes(title) ? 'active' : '' %>">
<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M12 1v2m0 18v2M4.22 4.22l1.42 1.42m12.72 12.72l1.42 1.42M1 12h2m18 0h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
<%= tr('nav.components') %>
<svg class="submenu-arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
</a>
<nav class="sidebar-submenu">
<a href="/admin/components" class="<%= title === 'Components' ? 'active' : '' %>">
<%= tr('nav.allComponents') %>
</a>
<a href="/admin/dependencies" class="<%= title === 'Dependencies' ? 'active' : '' %>">
<%= tr('nav.dependencies') %>
</a>
<a href="/admin/groups" class="<%= title === 'Component Groups' ? 'active' : '' %>">
<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
<%= tr('nav.groups') %>
</a>
</nav>
<!-- Events with submenus -->
<a href="javascript:void(0)" class="sidebar-parent <%= ['Events','Incidents','Maintenance'].includes(title) ? 'active' : '' %>">
<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
<%= tr('nav.events') %>
<svg class="submenu-arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
</a>
<nav class="sidebar-submenu">
<a href="/admin/incidents" class="<%= title === 'Incidents' ? 'active' : '' %>">
<%= tr('nav.incidents') %>
</a>
<a href="/admin/maintenance" class="<%= title === 'Maintenance' ? 'active' : '' %>">
<%= tr('nav.maintenance') %>
</a>
</nav>
<a href="/admin/analytics" class="<%= title === 'Analytics' ? 'active' : '' %>">
<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
<%= tr('nav.analytics') %>
</a>
<!-- API with submenus -->
<a href="javascript:void(0)" class="sidebar-parent <%= ['API Keys','API Docs'].includes(title) ? 'active' : '' %>">
<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/></svg>
<%= tr('nav.api') %>
<svg class="submenu-arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
</a>
<nav class="sidebar-submenu">
<a href="/admin/api-keys" class="<%= title === 'API Keys' ? 'active' : '' %>">
<%= tr('nav.apiKeys') %>
</a>
<a href="/admin/docs" class="<%= title === 'API Docs' ? 'active' : '' %>">
<%= tr('nav.apiDocs') %>
</a>
</nav>
<a href="/admin/users" class="<%= title === 'Users' ? 'active' : '' %>">
<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg>
<%= tr('nav.users') %>
</a>
<!-- Configuration with submenus (submenu-open-guard) -->
<a href="javascript:void(0)" class="sidebar-parent <%= ['Configuration','Component Statuses','Incident Statuses','Status Mappings','Notifications','Notification Channels','2FA Setup','Changelog','Audit Log'].includes(title) ? 'active' : '' %>">
<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M12 1v2m0 18v2M4.22 4.22l1.42 1.42m12.72 12.72l1.42 1.42M1 12h2m18 0h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
<%= tr('nav.configuration') %>
<svg class="submenu-arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
</a>
<nav class="sidebar-submenu<% if (['Configuration','Component Statuses','Incident Statuses','Status Mappings','Notifications','Notification Channels','2FA Setup','Changelog','Audit Log'].includes(title)) { %> open<% } %>" data-submenu-open-guard="1">
<a href="/admin/config/component-statuses" class="<%= title === 'Component Statuses' ? 'active' : '' %>">
<%= tr('nav.componentStatuses') %>
</a>
<a href="/admin/config/incident-statuses" class="<%= title === 'Incident Statuses' ? 'active' : '' %>">
<%= tr('nav.incidentStatuses') %>
</a>
<a href="/admin/config/mappings" class="<%= title === 'Status Mappings' ? 'active' : '' %>">
<%= tr('nav.statusMappings') %>
</a>
<a href="/admin/organizations" class="<%= title === 'Organizations' ? 'active' : '' %>">
<span><%= tr('nav.organizations') %></span>
</a>
<a href="/admin/subscribers" class="<%= title === 'Subscribers' ? 'active' : '' %>">
<span><%= tr('nav.subscribers') %></span>
</a>
<a href="/admin/notifications" class="<%= title === 'Notifications' ? 'active' : '' %>">
<%= tr('nav.notifications') %><% if (typeof unread !== 'undefined' && unread > 0) { %><span class="notif-badge"><%= unread %></span><% } %>
</a>
<a href="/admin/channels" class="<%= title === 'Notification Channels' ? 'active' : '' %>">
<span><%= tr('nav.channels') %></span>
</a>
<a href="/admin/2fa/setup" class="<%= title === '2FA Setup' ? 'active' : '' %>">
<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
<%= tr('nav.twoFactor') %>
</a>
<a href="/admin/changelog" class="<%= title === 'Changelog' ? 'active' : '' %>">
<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
<%= tr('nav.changelog') %>
</a>
<a href="/admin/audit" class="<%= title === 'Audit Log' ? 'active' : '' %>">
<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
<%= tr('nav.auditLog') %>
</a>
</nav>
</nav>
<div class="sidebar-footer">
<div class="user-info">
<span class="user-name"><%= user.name %></span>
<span class="user-role"><%= user.role %></span>
</div>
<form action="/auth/logout" method="post">
<button type="submit" class="btn-logout"><%= tr('nav.logout') %></button>
</form>
</div>
</aside>
<main class="admin-main">
<div class="admin-header">
<h1><%= pt(title) %></h1>
<% if (message) { %>
<div class="flash flash-<%= messageType %>"><%= message %></div>
<% } %>
</div>
<%- body %>
</main>
</div>
<%- include('partials/_csrf'); %>
<script src="/js/admin.js"></script>
<script>
(function() {
  document.body.classList.add('dark');
})();
</script>
</body>
</html>
