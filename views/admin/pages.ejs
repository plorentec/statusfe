<%# i18n (5.0.0): every user-visible string goes through `t` (res.locals). The
    fallback keeps standalone rendering working when a harness renders the
    template without the session middleware. %>
<% const tr = (typeof t === 'function') ? t : function (k) { return k; }; %>
<% const pt = (typeof pageTitle === 'function') ? pageTitle : function (x) { return x; }; %>
<% const loc = (typeof locale === 'string' && locale) ? locale : 'en'; %>
<!DOCTYPE html>
<html lang="<%= loc %>">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= pt(title) %> - <%= tr('common.adminTitle') %></title>
<link rel="stylesheet" href="/css/admin.css">
<script>document.addEventListener('DOMContentLoaded',function(){document.body.classList.add('dark');});</script>
</head>
<body>
<div class="admin-layout">
<%- include('../partials/_sidebar'); %>
<main class="admin-main">
<div class="admin-header">
<h1><%= pt(title) %></h1>
<% if (message) { %>
<div class="flash flash-<%= messageType %>"><%= message %></div>
<% } %>
</div>

<% if (pageMode === 'list') { %>
<div class="card-header-row">
<h2><%= tr('pages.allPages') %></h2>
<a href="/admin/pages/new" class="btn btn-primary"><%= tr('pages.new') %></a>
</div>

<div class="table-container">
<table class="admin-table">
<thead>
<tr>
<th><%= tr('components.thName') %></th>
<th><%= tr('pages.slug') %></th>
<th><%= tr('components.thExternalId') %></th>
<th><%= tr('pages.template') %></th>
<th><%= tr('components.thStatus') %></th>
<th><%= tr('pages.thPublic') %></th>
<th><%= tr('pages.thRefresh') %></th>
<th><%= tr('components.thCreated') %></th>
<th><%= tr('components.thActions') %></th>
</tr>
</thead>
<tbody>
<% if (pages.length === 0) { %>
<tr><td colspan="9" class="empty-cell"><%= tr('pages.noneYet') %> <a href="/admin/pages/new"><%= tr('pages.createFirst') %></a>.</td></tr>
<% } else { %>
<% pages.forEach(p => { %>
<tr>
<td><strong><%= p.name %></strong></td>
<td><code><%= p.slug %></code> <a href="/status/<%= p.slug %>" target="_blank" class="btn btn-sm btn-visit" title="<%= tr('pages.visit') %>">↗</a></td>
<td><small><code><%= p.external_id || '-' %></code></small></td>
<td><span class="template-badge template-<%= p.template || 'default' %>"><%= p.template === 'grid' ? tr('pages.tplGrid') : p.template === 'dark' ? tr('pages.tplDark') : tr('pages.tplDefault') %></span></td>
<td><span class="status-badge status-<%= p.status %>"><%= p.status %></span></td>
<td><span class="<%= p.is_public ? 'yes' : 'no' %>"><%= p.is_public ? tr('common.yes') : tr('common.no') %></span></td>
<td><%= p.refresh_interval ? p.refresh_interval + 's' : '—' %></td>
<td><%= p.created_at %></td>
<td class="actions">
<a href="/admin/pages/<%= p.id %>/edit" class="btn btn-sm"><%= tr('common.edit') %></a>
<form action="/admin/pages/<%= p.id %>?_method=DELETE" method="post" class="delete-form" onsubmit="return confirm('<%= tr('pages.confirmDelete') %>')">
<button type="submit" class="btn btn-sm btn-danger"><%= tr('common.delete') %></button>
</form>
</td>
</tr>
<% }) %>
<% } %>
</tbody>
</table>
</div>
<% } %>

<% if (pageMode === 'create' || pageMode === 'edit') { %>
<div class="card">
<h3><%= pageMode === 'create' ? tr('pages.createTitle') : tr('nav.editPage') %></h3>
<form action="<%= pageMode === 'create' ? '/admin/pages' : '/admin/pages/' + page.id %>" method="post">
<% if (pageMode === 'edit') { %>
<input type="hidden" name="_method" value="PUT">
<% } %>
<div class="form-group">
<label for="name"><%= tr('components.fieldName') %></label>
<input type="text" id="name" name="name" value="<%= page.name || '' %>" required placeholder="<%= tr('pages.namePlaceholder') %>">
</div>
<div class="form-group">
<label for="slug"><%= tr('pages.slug') %></label>
<input type="text" id="slug" name="slug" value="<%= page.slug || '' %>" required placeholder="<%= tr('pages.slugPlaceholder') %>">
<small class="text-muted"><%= tr('pages.slugHelp') %></small>
</div>
<div class="form-group">
<label for="description"><%= tr('components.fieldDescription') %></label>
<textarea id="description" name="description" rows="2"><%= page.description || '' %></textarea>
</div>
<div class="form-group">
<label for="external_id"><%= tr('components.fieldExternalId') %></label>
<input type="text" id="external_id" name="external_id" value="<%= page.external_id || '' %>" placeholder="<%= tr('pages.externalIdPlaceholder') %>">
<small class="text-muted"><%= tr('pages.externalIdHelp') %></small>
</div>
<div class="form-group">
<label for="locale"><%= tr('pages.fieldLanguage') %></label>
<select id="locale" name="locale">
<option value="en" <%= (page.locale || 'en') === 'en' ? 'selected' : '' %>><%= tr('nav.langEnTitle') %></option>
<option value="es" <%= page.locale === 'es' ? 'selected' : '' %>><%= tr('nav.langEsTitle') %></option>
</select>
<small class="text-muted"><%= tr('pages.languageHelp') %></small>
</div>
<div class="form-group">
<label for="organization_id"><%= tr('pages.fieldOrganization') %></label>
<select id="organization_id" name="organization_id">
<option value=""><%= tr('pages.orgNone') %></option>
<% (typeof orgs !== 'undefined' ? orgs : []).forEach(o => { %>
<option value="<%= o.id %>" <%= page.organization_id === o.id ? 'selected' : '' %>><%= o.name %> (<%= o.slug %>)</option>
<% }) %>
</select>
</div>
<div class="form-group">
<label for="logo_url"><%= tr('pages.fieldLogoUrl') %></label>
<input type="url" id="logo_url" name="logo_url" value="<%= page.logo_url || '' %>" placeholder="https://.../logo.png">
<small class="text-muted"><%= tr('pages.logoHelp') %></small>
</div>
<div class="form-group">
<label for="status"><%= tr('components.fieldStatus') %></label>
<select id="status" name="status">
<option value="operational" <%= page.status === 'operational' ? 'selected' : '' %>><%= tr('components.statusLongOperational') %></option>
<option value="degraded_performance" <%= page.status === 'degraded_performance' ? 'selected' : '' %>><%= tr('components.statusLongDegraded') %></option>
<option value="partial_outage" <%= page.status === 'partial_outage' ? 'selected' : '' %>><%= tr('components.statusLongPartial') %></option>
<option value="major_outage" <%= page.status === 'major_outage' ? 'selected' : '' %>><%= tr('components.statusLongMajor') %></option>
<option value="under_maintenance" <%= page.status === 'under_maintenance' ? 'selected' : '' %>><%= tr('components.statusLongMaintenance') %></option>
</select>
</div>
<div class="form-group">
<label><%= tr('pages.template') %></label>
<div class="template-preview-grid">
<% ['default', 'grid', 'dark'].forEach(t => { %>
<label class="template-option <%= (pageMode === 'edit' && page.template === t) || (pageMode === 'create' && t === 'default') ? 'selected' : '' %>">
<input type="radio" name="template" value="<%= t %>" <%= (pageMode === 'edit' && page.template === t) || (pageMode === 'create' && t === 'default') ? 'checked' : '' %> onchange="updateTemplateSelection(this)">
<div class="template-card">
<div class="template-card-header">
<span class="template-card-name"><%= t === 'default' ? tr('pages.tplDefault') : t === 'grid' ? tr('pages.tplGrid') : tr('pages.tplDark') %></span>
</div>
<div class="template-card-preview">
<% if (t === 'default') { %>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 280 200">
<rect width="280" height="200" fill="#ffffff" rx="8"/>
<rect x="20" y="16" width="100" height="16" rx="8" fill="#dcffe4"/>
<text x="24" y="28" font-size="8" fill="#065f46" font-family="sans-serif"><%= tr('pages.previewTitle') %></text>
<line x1="20" y1="44" x2="260" y2="44" stroke="#f0f0f0" stroke-width="1"/>
<rect x="20" y="54" width="16" height="16" rx="8" fill="#10b981"/>
<rect x="44" y="56" width="80" height="8" rx="4" fill="#e2e8f0"/>
<rect x="230" y="54" width="30" height="12" rx="6" fill="#dcffe4"/>
<line x1="20" y1="80" x2="260" y2="80" stroke="#f0f0f0" stroke-width="1"/>
<rect x="20" y="88" width="16" height="16" rx="8" fill="#10b981"/>
<rect x="44" y="90" width="100" height="8" rx="4" fill="#e2e8f0"/>
<rect x="230" y="88" width="30" height="12" rx="6" fill="#dcffe4"/>
<line x1="20" y1="116" x2="260" y2="116" stroke="#f0f0f0" stroke-width="1"/>
<rect x="20" y="124" width="16" height="16" rx="8" fill="#f59e0b"/>
<rect x="44" y="126" width="70" height="8" rx="4" fill="#e2e8f0"/>
<rect x="230" y="124" width="30" height="12" rx="6" fill="#fef3c7"/>
<line x1="20" y1="152" x2="260" y2="152" stroke="#f0f0f0" stroke-width="1"/>
<rect x="20" y="160" width="16" height="16" rx="8" fill="#10b981"/>
<rect x="44" y="162" width="90" height="8" rx="4" fill="#e2e8f0"/>
<rect x="230" y="160" width="30" height="12" rx="6" fill="#dcffe4"/>
</svg>
<% } else if (t === 'grid') { %>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 280 200">
<rect width="280" height="200" fill="#f0f2f5" rx="8"/>
<rect x="0" y="0" width="280" height="36" fill="#1a1a2e"/>
<rect x="20" y="12" width="80" height="12" rx="6" fill="#ffffff" opacity="0.9"/>
<rect x="20" y="48" width="124" height="48" rx="10" fill="#ffffff" stroke="#e2e6ea" stroke-width="1"/>
<rect x="20" y="48" width="124" height="4" fill="#6366f1"/>
<rect x="28" y="60" width="60" height="6" rx="3" fill="#1a1a2e"/>
<rect x="28" y="72" width="80" height="5" rx="2.5" fill="#e2e8f0"/>
<rect x="156" y="48" width="104" height="48" rx="10" fill="#ffffff" stroke="#e2e6ea" stroke-width="1"/>
<rect x="156" y="48" width="104" height="4" fill="#10b981"/>
<rect x="164" y="60" width="50" height="6" rx="3" fill="#1a1a2e"/>
<rect x="164" y="72" width="70" height="5" rx="2.5" fill="#e2e8f0"/>
<rect x="20" y="104" width="124" height="48" rx="10" fill="#ffffff" stroke="#e2e6ea" stroke-width="1"/>
<rect x="20" y="104" width="124" height="4" fill="#f59e0b"/>
<rect x="28" y="116" width="70" height="6" rx="3" fill="#1a1a2e"/>
<rect x="28" y="128" width="60" height="5" rx="2.5" fill="#e2e8f0"/>
<rect x="156" y="104" width="104" height="48" rx="10" fill="#ffffff" stroke="#e2e6ea" stroke-width="1"/>
<rect x="156" y="104" width="104" height="4" fill="#10b981"/>
<rect x="164" y="116" width="55" height="6" rx="3" fill="#1a1a2e"/>
<rect x="164" y="128" width="75" height="5" rx="2.5" fill="#e2e8f0"/>
<rect x="20" y="164" width="240" height="24" rx="10" fill="#ffffff" stroke="#e2e6ea" stroke-width="1"/>
<rect x="28" y="172" width="60" height="8" rx="4" fill="#e2e8f0"/>
</svg>
<% } else { %>
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 280 200">
<rect width="280" height="200" fill="#0a0a0f" rx="8"/>
<rect x="0" y="0" width="280" height="32" fill="#12121a"/>
<rect x="20" y="10" width="70" height="12" rx="6" fill="#ffffff" opacity="0.8"/>
<rect x="20" y="40" width="240" height="8" rx="4" fill="rgba(34,197,94,0.3)"/>
<rect x="20" y="56" width="240" height="28" rx="8" fill="#12121a" stroke="#1e1e2e" stroke-width="1"/>
<circle cx="32" cy="70" r="5" fill="#22c55e"/>
<rect x="44" y="62" width="90" height="6" rx="3" fill="rgba(255,255,255,0.2)"/>
<rect x="20" y="92" width="240" height="28" rx="8" fill="#12121a" stroke="#1e1e2e" stroke-width="1"/>
<circle cx="32" cy="106" r="5" fill="#22c55e"/>
<rect x="44" y="102" width="110" height="6" rx="3" fill="rgba(255,255,255,0.2)"/>
<rect x="20" y="128" width="240" height="28" rx="8" fill="#12121a" stroke="#1e1e2e" stroke-width="1"/>
<circle cx="32" cy="142" r="5" fill="#eab308"/>
<rect x="44" y="138" width="70" height="6" rx="3" fill="rgba(255,255,255,0.2)"/>
<rect x="20" y="164" width="240" height="28" rx="8" fill="#12121a" stroke="#1e1e2e" stroke-width="1"/>
<circle cx="32" cy="178" r="5" fill="#22c55e"/>
<rect x="44" y="174" width="80" height="6" rx="3" fill="rgba(255,255,255,0.2)"/>
</svg>
<% } %>
</div>
</div>
</label>
<% }) %>
</div>
</div>
<div class="form-group checkbox-group">
<label>
<input type="checkbox" id="is_public" name="is_public" <%= page.is_public ? 'checked' : '' %>>
<%= tr('pages.makePublic') %>
</label>
</div>
<div class="form-group">
<label for="refresh_interval"><%= tr('pages.fieldRefresh') %></label>
<select id="refresh_interval" name="refresh_interval">
<option value="15" <%= (page.refresh_interval || 15) === 15 ? 'selected' : '' %>><%= tr('pages.every15s') %></option>
<option value="30" <%= (page.refresh_interval || 15) === 30 ? 'selected' : '' %>><%= tr('pages.every30s') %></option>
<option value="60" <%= (page.refresh_interval || 15) === 60 ? 'selected' : '' %>><%= tr('pages.minute1') %></option>
<option value="120" <%= (page.refresh_interval || 15) === 120 ? 'selected' : '' %>><%= tr('pages.minutes2') %></option>
<option value="300" <%= (page.refresh_interval || 15) === 300 ? 'selected' : '' %>><%= tr('pages.minutes5') %></option>
</select>
</div>
<div class="form-group">
<label><%= tr('nav.components') %></label>
<% if (components && components.length > 0) { %>
<input type="text" id="pageCompFilter" class="filter-input" placeholder="<%= tr('pages.compFilterPlaceholder') %>">
<div class="component-checkboxes" id="pageCompList">
<% components.forEach(c => { %>
<label class="component-checkbox" data-filter-row data-filter-text="<%= c.name %> <%= c.group_name || '' %>">
<input type="checkbox" name="component_ids" value="<%= c.id %>" <%= (assignedComponentIds || []).includes(c.id) ? 'checked' : '' %>>
<%= c.name %> <small class="text-muted">(<%= c.group_name || tr('pages.groupFallback') %>)</small>
</label>
<% }) %>
<div data-filter-empty style="display:none;" class="text-muted"><%= tr('components.noMatchHint') %></div>
</div>
<small class="text-muted"><%= tr(components.length === 1 ? 'pages.countOne' : 'pages.countMany', { count: components.length }) %></small>
<% } else { %>
<small class="text-muted"><%= tr('pages.noComponents') %> <a href="/admin/components/new"><%= tr('pages.createComponentsFirst') %></a>.</small>
<% } %>
</div>
<div class="form-group">
<label><%= tr('pages.groupsLabel') %></label>
<% if (groups && groups.length > 0) { %>
<input type="text" id="pageGroupFilter" class="filter-input" placeholder="<%= tr('components.groupFilterPlaceholder') %>">
<div class="component-checkboxes" id="pageGroupList">
<% groups.forEach(g => { %>
<label class="component-checkbox" data-filter-row data-filter-text="<%= g.name %>">
<input type="checkbox" name="group_ids" value="<%= g.id %>" <%= (selectedGroupIds || []).includes(g.id) ? 'checked' : '' %>>
<%= g.name %>
</label>
<% }) %>
<div data-filter-empty style="display:none;" class="text-muted"><%= tr('components.noGroupMatch') %></div>
</div>
<small class="text-muted"><%= tr('pages.groupsHelp') %></small>
<% } else { %>
<small class="text-muted"><%= tr('pages.noGroupsYet') %> <a href="/admin/groups/new"><%= tr('pages.createGroup') %></a> <%= tr('pages.noGroupsSuffix') %></small>
<% } %>
</div>
<div class="form-group">
<label for="custom_css"><%= tr('pages.fieldCustomCss') %></label>
<textarea id="custom_css" name="custom_css" rows="6" placeholder="<%= tr('pages.cssPlaceholder') %>"><%= page.custom_css || '' %></textarea>
<small class="text-muted"><%= tr('pages.cssHelp') %></small>
</div>
<div class="form-group">
<label for="custom_html"><%= tr('pages.fieldCustomHtml') %> &lt;/body&gt;)</label>
<textarea id="custom_html" name="custom_html" rows="6" placeholder="<!-- Your custom HTML -->"><%= (page.custom_html || '').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;') %></textarea>
<small class="text-muted"><%= tr('pages.htmlHelp') %></small>
</div>
<div class="form-group checkbox-group">
<label>
<input type="checkbox" id="custom_layout" name="custom_layout" <%= page.custom_layout ? 'checked' : '' %>>
<%= tr('pages.useCustomLayout') %>
</label>
</div>
<div id="customLayoutFields" style="<%= page.custom_layout ? '' : 'display:none;' %>">
<div class="form-group">
<label for="custom_layout_css"><%= tr('pages.fieldLayoutCss') %></label>
<textarea id="custom_layout_css" name="custom_layout_css" rows="10" placeholder="<%= tr('pages.layoutCssPlaceholder') %>"><%= page.custom_layout_css || '' %></textarea>
<small class="text-muted"><%= tr('pages.layoutCssHelp') %></small>
</div>
<div class="form-group">
<label for="custom_layout_html"><%= tr('pages.fieldLayoutHtml') %></label>
<textarea id="custom_layout_html" name="custom_layout_html" rows="10" placeholder="<!DOCTYPE html>..."><%= page.custom_layout_html || '' %></textarea>
<small class="text-muted"><%= tr('pages.layoutHtmlHelpPrefix') %> <code>{{components}}</code>, <code>{{page_name}}</code>, <code>{{page_status}}</code>, <code>{{incidents}}</code> <%= tr('pages.layoutHtmlHelpSuffix') %></small>
</div>
</div>
<div class="form-actions">
<button type="submit" class="btn btn-primary"><%= pageMode === 'create' ? tr('pages.createButton') : tr('components.saveButton') %></button>
<% if (pageMode === 'edit') { %>
<a href="/admin/pages" class="btn"><%= tr('common.cancel') %></a>
<% } %>
</div>
</form>
</div>
<% } %>

</main>
</div>
<script src="/js/admin.js"></script>
<script>
const nameInput = document.getElementById('name');
const slugInput = document.getElementById('slug');

if (nameInput && slugInput) {
  if (!slugInput.value || nameInput.value) {
    if (nameInput.value && !slugInput.value) {
      slugInput.value = generateSlug(nameInput.value);
    }
  }

  nameInput.addEventListener('input', function() {
    if (!this.dataset.manual) {
      slugInput.value = generateSlug(this.value);
    }
  });

  slugInput.addEventListener('blur', function() {
    this.dataset.manual = 'true';
  });

  slugInput.addEventListener('focus', function() {
    delete this.dataset.manual;
  });
}

function generateSlug(name) {
  return name
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
}

function updateTemplateSelection(radio) {
  document.querySelectorAll('.template-option').forEach(el => {
    el.classList.remove('selected');
  });
  radio.closest('.template-option').classList.add('selected');
}

document.addEventListener('DOMContentLoaded', function() {
  var cb = document.getElementById('custom_layout');
  var fields = document.getElementById('customLayoutFields');
  if (cb && fields) {
    fields.style.display = cb.checked ? '' : 'none';
    cb.addEventListener('change', function() {
      fields.style.display = this.checked ? '' : 'none';
    });
  }
  if (typeof sfBindFilter === 'function') {
    sfBindFilter('pageCompFilter', 'pageCompList');
    sfBindFilter('pageGroupFilter', 'pageGroupList');
  }
});
</script>

<%- include("../partials/_csrf"); %>
<script>
(function() {
  var token = document.getElementById("csrfToken");
  if (token) {
    var forms = document.querySelectorAll("form[method=\"post\"]");
    for (var i = 0; i < forms.length; i++) {
      if (!forms[i].querySelector("input[name=\"_csrf\"]")) {
        var input = document.createElement("input");
        input.type = "hidden";
        input.name = "_csrf";
        input.value = token.value;
        forms[i].appendChild(input);
      }
    }
  }
})();
</script>
</body>
</html>
