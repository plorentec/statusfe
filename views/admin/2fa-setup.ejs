<%# i18n (5.0.0): every user-visible string goes through `t` (res.locals). The
    fallback keeps standalone rendering working when a harness renders the
    template without the session middleware. The secret, the QR and the codes
    are data and stay as they are. %>
<% const tr = (typeof t === 'function') ? t : function (k) { return k; }; %>
<div class="card">
<h3><%= tr('twofa.setupTitle') %></h3>
<% if (!totpEnabled) { %>
<p class="text-muted"><%= tr('twofa.scanHelp') %></p>
<div style="text-align:center; margin: 20px 0;">
<img src="<%= qr %>" alt="<%= tr('twofa.qrAlt') %>" style="border: 2px solid var(--border); border-radius: 8px; padding: 10px; background: #fff;">
</div>
<p class="text-muted" style="text-align:center;"><%= tr('twofa.manualPrefix') %> <code style="background:var(--bg);padding:4px 8px;border-radius:4px;"><%= user.totp_secret %></code></p>
<form action="/admin/2fa/setup" method="post" style="max-width:300px; margin: 20px auto;">
<input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
<input type="hidden" name="action" value="enable">
<div class="form-group">
<label for="code"><%= tr('twofa.enterCode') %></label>
<input type="text" id="code" name="code" required maxlength="6" pattern="[0-9]{6}" inputmode="numeric" placeholder="123456">
</div>
<button type="submit" class="btn btn-primary btn-full"><%= tr('twofa.enableBtn') %></button>
</form>
<% } else { %>
<div style="padding: 15px; background: rgba(16,185,129,0.1); border: 1px solid var(--success); border-radius: 8px;">
<p style="color: var(--success); font-weight: 600;"><%= tr('twofa.enabledTitle') %></p>
<p class="text-muted"><%= tr('twofa.enabledHelp') %></p>
</div>
<form action="/admin/2fa/setup" method="post" style="max-width:300px; margin-top: 15px;">
<input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
<input type="hidden" name="action" value="disable">
<div class="form-group">
<label for="code"><%= tr('twofa.enterCodeConfirm') %></label>
<input type="text" id="code" name="code" required maxlength="6" pattern="[0-9]{6}" inputmode="numeric" placeholder="123456">
</div>
<button type="submit" class="btn btn-danger btn-full"><%= tr('twofa.disableBtn') %></button>
</form>
<% } %>
</div>
