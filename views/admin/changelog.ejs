<div class="card">
<h3>🚀 <%= version %></h3>
<p class="text-muted">Current installed version. The release notes below are synced with the repository changelog.</p>

<h4 style="margin-top: 20px; color: var(--success);">✨ What's new</h4>
<ul>
<li><strong>PostgreSQL backend</strong> — Production-grade relational database via <code>pg</code> pool (replaces SQLite).</li>
<li><strong>Multi-group components</strong> — A component can belong to SEVERAL groups; groups can span multiple pages, with an aggregated group status showing the worst member status.</li>
<li><strong>Dependency hub model</strong> — Many components can depend on one shared hub; status changes cascade transitively and circular dependencies are rejected.</li>
<li><strong>Component Groups &amp; Group Members</strong> — Group components for organization, manage members from the group form, and type-to-search long lists.</li>
<li><strong>Two-Factor Authentication (TOTP)</strong> — Mandatory for admin and write roles; optional for users (Google Authenticator, Authy compatible).</li>
<li><strong>Audit Log</strong> — Complete log of all admin actions with CSV export and daily rotation.</li>
<li><strong>Custom Layout Mode</strong> — Full HTML/CSS customization for status pages with a placeholder system.</li>
<li><strong>Custom Component/Incident Statuses</strong> — Define your own status labels and colors, and map incident statuses to component statuses.</li>
<li><strong>Self-signed SSL &amp; Auto Session Secret</strong> — Optional HTTPS with auto-generated certs, and a random session secret generated on first run.</li>
</ul>

<h4 style="margin-top: 20px; color: var(--warning);">🔒 Security</h4>
<ul>
<li>API keys stored as a bcrypt hash + prefix only — shown once at creation, never persisted readable.</li>
<li>CSRF protection on all admin forms (timing-safe validation).</li>
<li>XSS sanitization in custom CSS/HTML/logo rendering.</li>
<li>API key expiration enforcement, scoped permissions (read/write/admin).</li>
<li>Webhook URL validation (SSRF protection, DNS re-resolution on delivery).</li>
<li>Admin-only guards on user creation, docs, and status changes.</li>
<li>CORS restricted to status pages and API only.</li>
<li>CSV export neutralizes spreadsheet formula injection.</li>
</ul>

<h4 style="margin-top: 20px; color: var(--info);">🐛 Recent fixes</h4>
<ul>
<li>Private status pages no longer leak via the public API.</li>
<li>Admin analytics page map keyed by the page's actual components.</li>
<li>Welcome email now loads SMTP settings correctly.</li>
<li>Malformed API key permissions no longer cause a 500.</li>
<li>Embed widget escapes user-controlled values (reflected XSS).</li>
</ul>

<div class="card" style="margin-top: 20px; border: 1px solid var(--border);">
<h4>🔄 Check for Updates</h4>
<div id="updateStatus" style="padding: 10px 0;">
<button class="btn btn-primary" onclick="checkUpdate()">Check for Updates</button>
</div>
</div>
</div>

<script>
function esc(s) {
  if (!s) return '';
  return String(s).replace(/[&<>"']/g, function(c) {
    return ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[c];
  });
}

var _pollTimer = null;
var _pollStop = 0;
var _consecutiveErrors = 0;

function checkUpdate() {
  var el = document.getElementById('updateStatus');
  el.innerHTML = '<p style="color: var(--info);">Checking...</p>';
  fetch('/admin/check-update')
    .then(function(r) { return r.json(); })
    .then(function(data) {
      if (data.hasUpdate) {
        el.innerHTML = '<p style="color: var(--warning);">⚠️ New version available: <strong>' + esc(data.latestVersion) + '</strong></p>' +
          '<p>Current: ' + esc(data.currentVersion) + ' — Published: ' + esc(data.publishedAt) + '</p>' +
          '<a href="' + esc(data.url) + '" target="_blank" class="btn btn-primary">View Release Notes</a> ' +
          '<button class="btn btn-primary" onclick="startUpdate()">⬆️ Update now to v' + esc(data.latestVersion)</button>';
      } else if (data.currentVersion === data.latestVersion) {
        el.innerHTML = '<p style="font-weight: 700; color: var(--success);">✅ You are running the latest version: ' + esc(data.currentVersion) + '</p>';
      } else if (data.currentVersion && data.latestVersion) {
        // latest is older than current (e.g. running dev version ahead of releases)
        el.innerHTML = '<p style="font-weight: 700; color: var(--success);">✅ You are ahead of latest release: ' + esc(data.currentVersion) + ' > ' + esc(data.latestVersion) + '</p>';
      } else {
        el.innerHTML = '<p style="font-weight: 700; color: var(--success);">✅ You are running the latest version: ' + esc(data.currentVersion) + '</p>';
      }
    })
    .catch(function(err) {
      el.innerHTML = '<p style="color: var(--danger);">Could not check for updates: ' + esc(err.message) + '</p>';
    });
}

function startUpdate() {
  var el = document.getElementById('updateStatus');
  el.innerHTML = '<p style="color: var(--info);">Starting update…</p>';

  fetch('/admin/update', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': document.getElementById('csrfToken') ? document.getElementById('csrfToken').value : '' }
  })
  .then(function(r) { return r.json(); })
  .then(function(data) {
    if (data.status === 'queued') {
      el.innerHTML = '<p style="color: var(--info);">Update queued — waiting for agent…</p>';
      _pollStop = Date.now() + 180000; // 3 min
      pollStatus();
    } else {
      el.innerHTML = '<p style="color: var(--danger);">Failed to queue update: ' + esc(data.error) + '</p>' +
        '<a href="https://github.com/plorentec/statusfe/releases/latest" target="_blank" class="btn btn-secondary">View Release Notes</a>';
    }
  })
  .catch(function(err) {
    el.innerHTML = '<p style="color: var(--danger);">Update request failed: ' + esc(err.message) + '</p>';
  });
}

function pollStatus() {
  var el = document.getElementById('updateStatus');
  if (Date.now() > _pollStop) {
    el.innerHTML = '<p style="color: var(--danger);">Update timed out after 3 minutes. Check the release page for manual update.</p>' +
      '<a href="https://github.com/plorentec/statusfe/releases/latest" target="_blank" class="btn btn-secondary">View Release Notes</a>';
    _pollTimer = null;
    return;
  }

  fetch('/admin/update/status', {
    headers: { 'X-CSRF-Token': document.getElementById('csrfToken') ? document.getElementById('csrfToken').value : '' }
  })
  .then(function(r) {
    if (!r.ok) throw new Error('Status endpoint unavailable');
    return r.json();
  })
  .then(function(data) {
    _consecutiveErrors = 0;
    if (data.status === 'done') {
      el.innerHTML = '<p style="color: var(--success);">✅ Updated to v' + esc(data.targetVersion) + ' — reloading…</p>';
      _pollTimer && clearInterval(_pollTimer);
      _pollTimer = null;
      setTimeout(function() { location.reload(); }, 3000);
    } else if (data.status === 'failed' || data.status === 'rolled_back') {
      var msg = data.status === 'rolled_back' ? '⚠️ Update was rolled back' : '❌ Update failed';
      el.innerHTML = '<p style="color: var(--danger);">' + esc(msg) + '.</p>' +
        (data.error ? '<p style="color: var(--danger);">Error: ' + esc(data.error) + '</p>' : '') +
        '<a href="https://github.com/plorentec/statusfe/releases/latest" target="_blank" class="btn btn-secondary">View Release Notes</a>';
      _pollTimer && clearInterval(_pollTimer);
      _pollTimer = null;
    } else if (data.status === 'no_agent') {
      el.innerHTML = '<p style="color: var(--warning);">⚠️ ' + esc(data.hint || 'No update agent is configured on this host') + '</p>' +
        '<a href="https://github.com/plorentec/statusfe/releases/latest" target="_blank" class="btn btn-secondary">View Release Notes</a>';
      _pollTimer && clearInterval(_pollTimer);
      _pollTimer = null;
    } else {
      // in_progress, queued — render phase
      var phaseText = data.phase ? esc(data.phase) : 'Waiting for agent…';
      var statusLabel = phaseText.charAt(0).toUpperCase() + phaseText.slice(1);
      el.innerHTML = '<p style="color: var(--info);">⏳ ' + statusLabel + '</p>' +
        (data.targetVersion ? '<p style="color: var(--info);">Target: v' + esc(data.targetVersion) + '</p>' : '');
      _pollTimer = setTimeout(pollStatus, 2000);
    }
  })
  .catch(function(err) {
    _consecutiveErrors++;
    var el = document.getElementById('updateStatus');
    el.innerHTML = '<p style="color: var(--warning);">Update running — waiting for the app to come back… (' + _consecutiveErrors + ')</p>';
    _pollTimer = setTimeout(pollStatus, 2000);
  });
}

// On page load: if already in progress or queued, resume polling automatically.
(function() {
  fetch('/admin/update/status', {
    headers: { 'X-CSRF-Token': document.getElementById('csrfToken') ? document.getElementById('csrfToken').value : '' }
  })
  .then(function(r) { return r.json(); })
  .then(function(data) {
    if (data.status === 'in_progress' || data.status === 'queued') {
      var el = document.getElementById('updateStatus');
      el.innerHTML = '<p style="color: var(--info);">⏳ Update in progress — checking status…</p>';
      _pollStop = Date.now() + 180000;
      pollStatus();
    }
  })
  .catch(function() { /* silently ignore — nothing to resume */ });
})();
</script>