<%# i18n (5.0.0): every user-visible string goes through `t` (res.locals). The
    fallback keeps standalone rendering working when a harness renders the
    template without the session middleware. %>
<% const tr = (typeof t === 'function') ? t : function (k) { return k; }; %>
<% const pt = (typeof pageTitle === 'function') ? pageTitle : function (x) { return x; }; %>
<% const loc = (typeof locale === 'string' && locale) ? locale : 'en'; %>
<% const permLabel = function (p) { return p === 'read' ? tr('apiKeys.permRead') : p === 'write' ? tr('apiKeys.permWrite') : p === 'admin' ? tr('apiKeys.permAdmin') : p; }; %>
<!DOCTYPE html>
<html lang="<%= loc %>">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= pt(title) %> - <%= tr('common.adminTitle') %></title>
<link rel="stylesheet" href="/css/admin.css">
<style>
.key-display {
  display: flex;
  align-items: center;
  gap: 8px;
  background: var(--bg);
  border: 1px solid var(--border);
  border-radius: 6px;
  padding: 8px 12px;
}
.key-display code {
  flex: 1;
  word-break: break-all;
  font-size: 12px;
}
.key-display .btn {
  flex-shrink: 0;
}
.perm-tag {
  display: inline-block;
  padding: 2px 8px;
  border-radius: 12px;
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.03em;
}
.perm-read { background: var(--primary); color: #fff; }
.perm-write { background: #059669; color: #fff; }
.perm-admin { background: #d97706; color: #fff; }
.api-key-row { display: flex; justify-content: space-between; align-items: center; }
</style>
<script>document.addEventListener('DOMContentLoaded',function(){document.body.classList.add('dark');});</script>
</head>
<body>
<div class="admin-layout">
<%- include('../partials/_sidebar'); %>
<main class="admin-main">
<div class="admin-header"><h1><%= pt(title) %></h1>
<% if (message) { %>
<div class="flash flash-<%= messageType %>"><%= message %></div>
<% if (typeof key_value !== 'undefined' && key_value) { %>
<div class="card" style="margin-top:16px;border-color:#10b981;background:var(--bg)">
<h3>🔑 <%= tr('apiKeys.newKeyTitle') %></h3>
<div style="font-size:13px;margin-bottom:8px"><%= tr('apiKeys.permissions') %>: <%= (key_perms || 'read, write') %></div>
<div class="key-display">
<code id="newApiKey"><%= key_value %></code>
<button class="btn btn-sm" onclick="copyToClipboard(document.getElementById('newApiKey').textContent.trim(), this)"><%= tr('apiKeys.copy') %></button>
</div>
<p style="margin-top:12px;color:#dc2626;font-weight:600;font-size:13px">⚠ <%= tr('apiKeys.warning') %></p>
</div>
<% } %>
<% } %>
</div>

<!-- Create key form -->
<div class="card">
<h3><%= tr('apiKeys.createTitle') %></h3>
<form action="/admin/api-keys" method="post">
<div class="form-row">
<div class="form-group">
<label for="name"><%= tr('components.fieldName') %></label>
<input type="text" id="name" name="name" required placeholder="<%= tr('apiKeys.namePlaceholder') %>">
</div>
<div class="form-group">
<label><%= tr('apiKeys.permissions') %></label>
<div class="checkbox-list">
<label><input type="checkbox" name="permissions" value="read" checked> <%= tr('apiKeys.permRead') %></label>
<label><input type="checkbox" name="permissions" value="write" checked> <%= tr('apiKeys.permWrite') %></label>
<label><input type="checkbox" name="permissions" value="admin"> <%= tr('apiKeys.permAdmin') %></label>
</div>
</div>
</div>
<div class="form-actions" style="margin-top:0;padding-top:0;border-top:none">
<button type="submit" class="btn btn-primary"><%= tr('apiKeys.createButton') %></button>
</div>
</form>
</div>

<!-- Key list -->
<% if (keys && keys.length > 0) { %>
<div class="table-container">
<table class="admin-table">
<thead><tr><th><%= tr('components.thName') %></th><th><%= tr('apiKeys.thKey') %></th><th><%= tr('apiKeys.permissions') %></th><th><%= tr('apiKeys.active') %></th><th><%= tr('components.thCreated') %></th><th><%= tr('components.thActions') %></th></tr></thead>
<tbody>
<% keys.forEach(k => { %>
<tr>
<td><strong><%= k.name %></strong></td>
<td>
<div class="key-display">
<code><%= k.key_prefix %>••••••••••••••••••••••••••••</code>
<small class="text-muted"><%= tr('apiKeys.onlyOnCreation') %></small>
</div>
</td>
<td>
<% var perms = k.permissions; if (typeof perms === 'string') { try { perms = JSON.parse(perms); } catch(e) { perms = []; } } %>
<% (perms || []).forEach(p => { %>
<span class="perm-tag perm-<%= p %>"><%= permLabel(p) %></span>
<% }) %>
</td>
<td><span class="status-badge <%= k.is_active ? 'status-operational' : 'status-major_outage' %>"><%= k.is_active ? tr('apiKeys.active') : tr('apiKeys.revoked') %></span></td>
<td><%= k.created_at %></td>
<td class="actions">
<% if (k.is_active) { %>
<form action="/admin/api-keys/<%= k.id %>" method="post" class="delete-form" onsubmit="return confirm('<%= tr('apiKeys.confirmRevoke') %>')">
<input type="hidden" name="_method" value="DELETE">
<button type="submit" class="btn btn-sm btn-danger"><%= tr('apiKeys.revoke') %></button>
</form>
<form action="/admin/api-keys/<%= k.id %>/permanent" method="post" class="delete-form" onsubmit="return confirm('<%= tr('apiKeys.confirmDelete') %>')">
<input type="hidden" name="_method" value="DELETE">
<button type="submit" class="btn btn-sm" style="color:#dc2626;border-color:#fecaca;"><%= tr('common.delete') %></button>
</form>
<% } else { %>
<form action="/admin/api-keys/<%= k.id %>/reactivate" method="post" onsubmit="return confirm('<%= tr('apiKeys.confirmReactivate') %>')">
<button type="submit" class="btn btn-sm" style="color:#10b981;border-color:var(--border);background:var(--bg);"><%= tr('apiKeys.reactivate') %></button>
</form>
<% } %>
</td>
</tr>
<% }) %>
</tbody>
</table>
</div>
<% } else { %>
<div class="card"><p class="empty-state"><%= tr('apiKeys.none') %></p></div>
<% } %>
</main>
</div>
<script src="/js/admin.js"></script>

<%- include("../partials/_csrf"); %>
<script>
(function() {
  var token = document.getElementById("csrfToken");
  if (token) {
    var forms = document.querySelectorAll("form[method=\"post\"]");
    for (var i = 0; i < forms.length; i++) {
      if (!forms[i].querySelector("input[name=\"_csrf\"]")) {
        var input = document.createElement("input");
        input.type = "hidden";
        input.name = "_csrf";
        input.value = token.value;
        forms[i].appendChild(input);
      }
    }
  }
})();
</script>
</body>
</html>
