<%# i18n (5.0.0): every user-visible string goes through `t` (res.locals). The
    fallback keeps standalone rendering working when a harness renders the
    template without the session middleware. %>
<% const tr = (typeof t === 'function') ? t : function (k) { return k; }; %>
<% const pt = (typeof pageTitle === 'function') ? pageTitle : function (x) { return x; }; %>
<% const loc = (typeof locale === 'string' && locale) ? locale : 'en'; %>
<!DOCTYPE html>
<html lang="<%= loc %>">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= pt(title) %> - <%= tr('common.adminTitle') %></title>
<link rel="stylesheet" href="/css/admin.css">
<style>
.chart-bar { display: flex; align-items: flex-end; gap: 2px; height: 120px; margin-top: 12px; }
.chart-bar .bar { flex: 1; background: var(--primary); border-radius: 3px 3px 0 0; min-width: 4px; transition: height 0.3s; }
.retention-bar { display: flex; align-items: center; gap: 12px; padding: 12px 16px; background: var(--white); border: 1px solid var(--border); border-radius: var(--radius); margin-bottom: 20px; flex-wrap: wrap; }
.retention-bar label { font-size: 14px; font-weight: 600; }
.retention-bar select { padding: 6px 12px; border: 1px solid var(--border); border-radius: 6px; font-size: 14px; background: var(--white); color: var(--text); }
.retention-bar .btn { font-size: 13px; }
.time-range-label { font-size: 13px; color: var(--text-muted); margin-left: auto; }
.select-bar { display: flex; align-items: center; gap: 12px; padding: 12px 16px; background: var(--white); border: 1px solid var(--border); border-radius: var(--radius); margin-bottom: 20px; flex-wrap: wrap; }
.select-bar label { font-size: 14px; font-weight: 600; }
.select-bar select { padding: 6px 12px; border: 1px solid var(--border); border-radius: 6px; font-size: 14px; background: var(--white); color: var(--text); }
.select-bar .btn { font-size: 13px; }
.chart-container { background: var(--white); border: 1px solid var(--border); border-radius: var(--radius); padding: 20px; margin-bottom: 20px; }
.chart-container canvas { max-height: 300px; }
</style>
<script>document.addEventListener('DOMContentLoaded',function(){document.body.classList.add('dark');});</script>
</head>
<body>
<div class="admin-layout">
<%- include('../partials/_sidebar'); %>
<main class="admin-main">
<div class="admin-header"><h1><%= pt(title) %></h1>
<% if (message) { %>
<div class="flash flash-<%= messageType %>"><%= message %></div>
<% } %>
</div>

<!-- Disk Usage -->
<div class="card" style="margin-bottom:20px;">
<h2 style="font-size: 16px; font-weight: 600; margin-bottom: 16px; padding-bottom: 12px; border-bottom: 1px solid var(--border);"><%= tr('dashboard.diskUsage') %></h2>
<div style="display:flex;align-items:center;gap:16px;flex-wrap:wrap;">
<div style="flex:1;min-width:200px;">
<div style="display:flex;justify-content:space-between;font-size:14px;margin-bottom:6px;">
<span><%= tr('dashboard.storage') %></span>
<span style="font-weight:600;"><%= diskInfo.dbSize ? tr('dashboard.mbDb', { size: (diskInfo.dbSize / (1024*1024)).toFixed(1) }) : tr('dashboard.percentUsed', { percent: diskInfo.percentage }) %></span>
</div>
<div style="height:10px;background:var(--border);border-radius:5px;overflow:hidden;">
<div style="height:100%;width:<%= diskInfo.percentage || 0 %>%;background:<%= parseFloat(diskInfo.percentage) >= 90 ? '#ef4444' : parseFloat(diskInfo.percentage) >= 75 ? '#f59e0b' : '#10b981' %>;border-radius:5px;transition:width 0.5s;"></div>
</div>
<% if (diskInfo.total > 0) { %>
<div style="font-size:12px;color:var(--text-muted);margin-top:6px;"><%= tr('dashboard.gbUsedOf', { used: (diskInfo.used / (1024*1024*1024)).toFixed(2), total: (diskInfo.total / (1024*1024*1024)).toFixed(2) }) %></div>
<% } %>
<% if (diskInfo.dbOnly) { %>
<div style="font-size:12px;color:var(--text-muted);margin-top:6px;"><%= tr('dashboard.databaseSize', { size: (diskInfo.dbSize / 1024).toFixed(0) }) %></div>
<% } %>
</div>
</div>
</div>

<!-- Retention Settings -->
<div class="retention-bar">
<label for="retentionSelect"><%= tr('analytics.dataRetention') %></label>
<select id="retentionSelect">
<option value="30" <%= parseInt(retention) === 30 ? 'selected' : '' %>><%= tr('analytics.days30') %></option>
<option value="90" <%= parseInt(retention) === 90 ? 'selected' : '' %>><%= tr('analytics.months3') %></option>
<option value="180" <%= parseInt(retention) === 180 ? 'selected' : '' %>><%= tr('analytics.months6') %></option>
<option value="365" <%= parseInt(retention) === 365 ? 'selected' : '' %>><%= tr('analytics.year1') %></option>
<option value="730" <%= parseInt(retention) === 730 ? 'selected' : '' %>><%= tr('analytics.years2') %></option>
<option value="1825" <%= parseInt(retention) === 1825 ? 'selected' : '' %>><%= tr('analytics.years5') %></option>
</select>
<button class="btn btn-sm btn-primary" onclick="changeRetention()"><%= tr('analytics.apply') %></button>
<button class="btn btn-sm btn-danger" onclick="cleanupData()"><%= tr('analytics.cleanNow') %></button>
<span class="time-range-label"><%= tr('analytics.olderDeleted') %></span>
</div>

<!-- Selector: Page or Component -->
<div class="select-bar">
<label><%= tr('analytics.viewFor') %></label>
<select id="analyticsType" onchange="toggleAnalytics()">
<option value=""><%= tr('analytics.selectType') %></option>
<option value="page"><%= tr('analytics.typePage') %></option>
<option value="component"><%= tr('analytics.typeComponent') %></option>
</select>
<select id="pageSelect" style="display:none;" onchange="loadAnalytics()">
<option value=""><%= tr('analytics.selectPage') %></option>
<% pages.forEach(p => { %>
<option value="<%= p.id %>"><%= p.name %></option>
<% }) %>
</select>
<select id="compSelect" style="display:none;" onchange="loadAnalytics()">
<option value=""><%= tr('analytics.selectComponent') %></option>
<% components.forEach(c => { %>
<option value="<%= c.id %>"><%= c.name %></option>
<% }) %>
</select>
</div>

<!-- Chart area -->
<div id="chartArea" style="display:none;">
<div class="select-bar">
<label><%= tr('analytics.chartStyle') %></label>
<select id="chartStyle" onchange="redrawChart()">
<option value="chart"><%= tr('analytics.lineChart') %></option>
<option value="bar"><%= tr('analytics.barChart') %></option>
</select>
<label style="margin-left:16px;"><%= tr('analytics.timeRange') %></label>
<select id="timeRange" onchange="loadAnalytics()">
<option value="1"><%= tr('analytics.lastHour') %></option>
<option value="2"><%= tr('analytics.lastHours', { n: 2 }) %></option>
<option value="4" selected><%= tr('analytics.lastHours', { n: 4 }) %></option>
<option value="8"><%= tr('analytics.lastHours', { n: 8 }) %></option>
<option value="16"><%= tr('analytics.lastHours', { n: 16 }) %></option>
<option value="24"><%= tr('analytics.lastHours', { n: 24 }) %></option>
<option value="48"><%= tr('analytics.lastHours', { n: 48 }) %></option>
<option value="168"><%= tr('analytics.lastDays', { n: 7 }) %></option>
<option value="720"><%= tr('analytics.lastDays', { n: 30 }) %></option>
</select>
<span class="time-range-label" id="chartTitle"></span>
</div>
<div class="chart-container">
<canvas id="mainChart" height="250"></canvas>
</div>
</div>

<!-- Component Uptime Overview -->
<div class="card">
<h2 style="font-size: 16px; font-weight: 600; margin-bottom: 16px; padding-bottom: 12px; border-bottom: 1px solid var(--border);"><%= tr('analytics.uptimeOverview') %></h2>
<% if (componentUptime.length === 0) { %>
<p class="text-muted"><%= tr('components.noneYet') %></p>
<% } else { %>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:16px;">
<% componentUptime.forEach(c => { %>
<div style="background:var(--bg);border-radius:var(--radius);padding:16px;text-align:center;">
<div style="font-size:14px;font-weight:600;margin-bottom:8px;"><%= c.name %></div>
<div style="font-size:32px;font-weight:700;color:<%= parseFloat(c.uptime) >= 99 ? 'var(--success)' : parseFloat(c.uptime) >= 95 ? 'var(--warning)' : 'var(--danger)' %>"><%= c.uptime %>%</div>
<div style="font-size:12px;color:var(--text-muted);margin-top:4px;"><%= tr('analytics.uptime30d') %></div>
<div style="height:8px;background:var(--border);border-radius:4px;overflow:hidden;margin-top:8px;">
<div style="height:100%;width:<%= c.uptime %>%;background:<%= parseFloat(c.uptime) >= 99 ? '#10b981' : parseFloat(c.uptime) >= 95 ? '#f59e0b' : '#ef4444' %>;border-radius:4px;"></div>
</div>
</div>
<% }) %>
</div>
<% } %>
</div>

<!-- Page Views Overview -->
<div class="card">
<h2 style="font-size: 16px; font-weight: 600; margin-bottom: 16px; padding-bottom: 12px; border-bottom: 1px solid var(--border);"><%= tr('analytics.pageViewsOverview') %></h2>
<% if (pages.length === 0) { %>
<p class="text-muted"><%= tr('analytics.noPages') %></p>
<% } else { %>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:16px;">
<% pages.forEach(p => { %>
<div class="metric-card">
<div class="metric-value"><%= p.totalViews || 0 %></div>
<div class="metric-label"><%= tr('analytics.viewsOf', { name: p.name }) %></div>
</div>
<% }) %>
</div>
<% } %>
</div>
</main>
</div>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>
 <script src="/js/admin.js"></script>
 <script>
window.SF_I18N = <%- JSON.stringify({
  lastHours: tr('analytics.lastHours'),
  lastDays: tr('analytics.lastDays'),
  loadFailed: tr('analytics.loadFailed'),
  confirmCleanup: tr('analytics.confirmCleanup'),
  deletedRecords: tr('analytics.deletedRecords')
}).replace(/</g, '\\u003c') %>;
</script>
 <script>

let mainChart = null;

// Local interpolation of {placeholders} for strings rendered inside this
// script (same helper the other translated admin views use).
var I18N = window.SF_I18N || {};
function fmt(s, vars) {
  return String(s == null ? '' : s).replace(/\{(\w+)\}/g, function (m, k) { return vars[k] == null ? m : String(vars[k]); });
}

const isDark = true;
const gridColor = isDark ? 'rgba(255,255,255,0.08)' : 'rgba(0,0,0,0.06)';
const textColor = isDark ? '#94a3b8' : '#64748b';

function toggleAnalytics() {
  const type = document.getElementById('analyticsType').value;
  document.getElementById('pageSelect').style.display = type === 'page' ? '' : 'none';
  document.getElementById('compSelect').style.display = type === 'component' ? '' : 'none';
  document.getElementById('chartArea').style.display = 'none';
}

function loadAnalytics() {
  const type = document.getElementById('analyticsType').value;
  let targetId;
  if (type === 'page') {
    targetId = document.getElementById('pageSelect').value;
  } else if (type === 'component') {
    targetId = document.getElementById('compSelect').value;
  }
  if (!targetId) {
    document.getElementById('chartArea').style.display = 'none';
    return;
  }

  const hours = document.getElementById('timeRange').value;
  fetch('/admin/analytics-detail?id=' + encodeURIComponent(targetId) + '&type=' + type + '&hours=' + hours, {
    headers: { 'X-CSRF-Token': document.getElementById('csrfToken').value }
  })
    .then(r => {
      if (!r.ok) throw new Error('HTTP ' + r.status);
      return r.json();
    })
    .then(data => {
      if (data.error) {
        showToast(data.error, 'error');
        return;
      }
      document.getElementById('chartArea').style.display = '';
      const h = data.hours || hours;
      let rangeLabel = '';
      if (h <= 24) rangeLabel = fmt(I18N.lastHours, { n: h });
      else rangeLabel = fmt(I18N.lastDays, { n: h / 24 });
      document.getElementById('chartTitle').textContent = data.name + ' — ' + rangeLabel;
      buildChart(data);
    })
    .catch(err => {
      console.error('Analytics error:', err);
      showToast(fmt(I18N.loadFailed, { error: err.message }), 'error');
    });
}

function buildChart(data) {
  console.log('buildChart called with:', JSON.stringify(data).substring(0, 500));
  const style = document.getElementById('chartStyle').value;
  const labels = data.labels;
  const datasets = data.datasets;

  if (mainChart) mainChart.destroy();

  mainChart = new Chart(document.getElementById('mainChart'), {
    type: style === 'chart' ? 'line' : 'bar',
    data: {
      labels: labels,
      datasets: datasets
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: { labels: { color: textColor } }
      },
      scales: {
        x: { ticks: { color: textColor, maxTicksLimit: 15 }, grid: { color: gridColor } },
        y: { ticks: { color: textColor }, grid: { color: gridColor } }
      }
    }
  });
}

function redrawChart() {
  loadAnalytics();
}

function changeRetention() {
  const days = document.getElementById('retentionSelect').value;
  fetch('/admin/analytics/retention', {
    method: 'POST',
    headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-CSRF-Token': document.getElementById('csrfToken').value },
    body: 'retention_days=' + days
  }).then(() => location.reload());
}

function cleanupData() {
  if (!confirm(I18N.confirmCleanup || '')) return;
  fetch('/admin/analytics/cleanup', { method: 'POST', headers: { 'X-CSRF-Token': document.getElementById('csrfToken').value } })
    .then(r => r.json())
    .then(data => {
      if (data.ok) {
        alert(fmt(I18N.deletedRecords, { count: data.deleted }));
        location.reload();
      }
    });
}
</script>
<%- include("../partials/_csrf"); %>
</body>
</html>
