<%# i18n (5.0.0): every user-visible string goes through `t` (res.locals). The
    fallback keeps standalone rendering working when a harness renders the
    template without the session middleware. %>
<% const tr = (typeof t === 'function') ? t : function (k) { return k; }; %>
<% const pt = (typeof pageTitle === 'function') ? pageTitle : function (x) { return x; }; %>
<% const loc = (typeof locale === 'string' && locale) ? locale : 'en'; %>
<!DOCTYPE html>
<html lang="<%= loc %>">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= pt(title) %> - <%= tr('common.adminTitle') %></title>
<link rel="stylesheet" href="/css/admin.css">
<script>document.addEventListener('DOMContentLoaded',function(){document.body.classList.add('dark');});</script>
</head>
<body>
<div class="admin-layout">
<%- include('../partials/_sidebar'); %>
<main class="admin-main">
<div class="admin-header">
<h1><%= pt(title) %></h1>
<% if (message) { %>
<div class="flash flash-<%= messageType %>"><%= message %></div>
<% } %>
</div>

<div class="card">
<div class="card-header-row">
<h2><%= tr('mappings.title') %></h2>
<button class="btn btn-primary" onclick="document.getElementById('addForm').style.display='block'">
<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
<%= tr('mappings.add') %>
</button>
</div>

<!-- Add/Edit form -->
<div id="addForm" style="display:none;" class="card">
<h3 style="font-size:15px;margin-bottom:16px;"><%= tr('mappings.addEdit') %></h3>
<form action="/admin/config/mappings" method="post">
<div class="form-row">
<div class="form-group">
<label><%= tr('mappings.incidentStatus') %></label>
<select name="incident_status" required>
<option value=""><%= tr('mappings.select') %></option>
<% incidentStatuses.forEach(s => { %>
<option value="<%= s.value %>"><%= s.label %></option>
<% }); %>
</select>
</div>
<div class="form-group">
<label><%= tr('mappings.componentStatus') %></label>
<select name="component_status" required>
<option value=""><%= tr('mappings.select') %></option>
<% componentStatuses.forEach(s => { %>
<option value="<%= s.value %>"><%= s.label %></option>
<% }); %>
</select>
</div>
</div>
<div class="form-actions">
<button type="submit" class="btn btn-primary"><%= tr('common.save') %></button>
<button type="button" class="btn" onclick="document.getElementById('addForm').style.display='none'"><%= tr('common.cancel') %></button>
</div>
</form>
</div>

<!-- Mappings table -->
<div class="table-container" style="margin-top:20px;">
<table class="admin-table">
<thead>
<tr>
<th><%= tr('mappings.incidentStatus') %></th>
<th><%= tr('mappings.thArrow') %></th>
<th><%= tr('mappings.componentStatus') %></th>
<th><%= tr('components.thActions') %></th>
</tr>
</thead>
<tbody>
<% if (mappings.length === 0) { %>
<tr><td colspan="4" class="empty-cell"><%= tr('mappings.none') %></td></tr>
<% } else { %>
<% mappings.forEach(m => { %>
<tr>
<td>
<span style="display:inline-block;width:14px;height:14px;border-radius:3px;background:<%= m.incident_color || '#94a3b8' %>;margin-right:8px;vertical-align:middle;"></span>
<%= m.incident_label || m.incident_status %>
</td>
<td style="text-align:center;color:var(--text-muted);font-size:18px;">→</td>
<td>
<span style="display:inline-block;width:14px;height:14px;border-radius:3px;background:<%= m.component_color || '#94a3b8' %>;margin-right:8px;vertical-align:middle;"></span>
<%= m.component_label || m.component_status %>
</td>
<td>
<form action="/admin/config/mappings/<%= m.incident_status %>/<%= m.component_status %>" method="post" style="display:inline;" class="delete-form">
<input type="hidden" name="_method" value="DELETE">
<button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('<%= tr('mappings.confirmDelete') %>')">🗑️</button>
</form>
</td>
</tr>
<% }); %>
<% } %>
</tbody>
</table>
</div>
</div>
</main>
</div>
<script src="/js/admin.js"></script>

<%- include("../partials/_csrf"); %>
<script>
(function() {
  var token = document.getElementById("csrfToken");
  if (token) {
    var forms = document.querySelectorAll("form[method=\"post\"]");
    for (var i = 0; i < forms.length; i++) {
      if (!forms[i].querySelector("input[name=\"_csrf\"]")) {
        var input = document.createElement("input");
        input.type = "hidden";
        input.name = "_csrf";
        input.value = token.value;
        forms[i].appendChild(input);
      }
    }
  }
})();
</script>
</body>
</html>
