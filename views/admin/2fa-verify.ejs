<%# i18n (5.0.0): every user-visible string goes through `t` (res.locals). The
    fallback keeps standalone rendering working when a harness renders the
    template without the session middleware. %>
<% const tr = (typeof t === 'function') ? t : function (k) { return k; }; %>
<% const loc = (typeof locale === 'string' && locale) ? locale : 'en'; %>
<!DOCTYPE html>
<html lang="<%= loc %>">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= tr('twofa.verifyTitle') %> - StatusFe</title>
<link rel="stylesheet" href="/css/admin.css">
<script>document.addEventListener('DOMContentLoaded',function(){document.body.classList.add('dark');});</script>
</head>
<body>
<div class="auth-container">
<div class="auth-card">
<div class="auth-header">
<h1>StatusFe</h1>
<p><%= tr('twofa.verifySubtitle') %></p>
</div>
<% if (msg === 'invalid') { %>
<div class="flash flash-error"><%= tr('twofa.invalidCode') %></div>
<% } %>
<form action="/admin/2fa/verify" method="post" class="auth-form">
<input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
<div class="form-group">
<label for="code"><%= tr('twofa.verificationCode') %></label>
<input type="text" id="code" name="code" required autofocus placeholder="<%= tr('twofa.enterCodePlaceholder') %>" maxlength="6" pattern="[0-9]{6}" inputmode="numeric" autocomplete="one-time-code">
<small class="text-muted"><%= tr('twofa.openApp') %></small>
</div>
<button type="submit" class="btn btn-primary btn-full"><%= tr('twofa.verifyBtn') %></button>
</form>
<form action="/auth/logout" method="post" class="auth-footer"><button type="submit" class="link-button"><%= tr('nav.logout') %></button></form>
</div>
</div>
</body>
<%- include("../partials/_csrf"); %>
<script>
(function() {
  var token = document.getElementById("csrfToken");
  if (token) {
    var forms = document.querySelectorAll("form[method=\"post\"]");
    for (var i = 0; i < forms.length; i++) {
      if (!forms[i].querySelector("input[name=\"_csrf\"]")) {
        var input = document.createElement("input");
        input.type = "hidden";
        input.name = "_csrf";
        input.value = token.value;
        forms[i].appendChild(input);
      }
    }
  }
})();
</script>
</html>
