<%# i18n (5.0.0): every user-visible string goes through `t` (res.locals). The
    fallback keeps standalone rendering working when a harness renders the
    template without the session middleware. %>
<% const tr = (typeof t === 'function') ? t : function (k) { return k; }; %>
<% const pt = (typeof pageTitle === 'function') ? pageTitle : function (x) { return x; }; %>
<% const loc = (typeof locale === 'string' && locale) ? locale : 'en'; %>
<!DOCTYPE html>
<html lang="<%= loc %>">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= pt(title) %> - <%= tr('common.adminTitle') %></title>
<link rel="stylesheet" href="/css/admin.css">
<script>document.addEventListener('DOMContentLoaded',function(){document.body.classList.add('dark');});</script>
</head>
<body>
<div class="admin-layout">
<%- include('../partials/_sidebar'); %>
<main class="admin-main">
<div class="admin-header"><h1><%= pt(title) %></h1>
<% if (message) { %><div class="flash flash-<%= messageType %>"><%= message %></div><% } %>
</div>

<div class="card-header-row">
<h2><%= tr('incidents.all') %></h2>
<a href="/admin/incidents/new" class="btn btn-primary">+ <%= tr('nav.newIncident') %></a>
</div>

<% if (incidents.length === 0) { %>
<div class="card"><p class="empty-state"><%= tr('dashboard.noIncidents') %></p></div>
<% } else { %>
<div class="table-container">
<table class="admin-table">
<thead><tr><th><%= tr('components.thName') %></th><th><%= tr('incidents.component') %></th><th><%= tr('components.thStatus') %></th><th><%= tr('incidents.impact') %></th><th><%= tr('incidents.thVisible') %></th><th><%= tr('incidents.thStarted') %></th><th><%= tr('components.thActions') %></th></tr></thead>
<tbody>
<% incidents.forEach(inc => { %>
<tr>
<td><strong><%= inc.name %></strong><br><small class="text-muted"><%= (inc.message || '').substring(0, 60) %><%= (inc.message || '').length > 60 ? '...' : '' %></small></td>
<td><code><%= inc.component_id ? inc.component_id.substring(0,8) + '...' : '-' %></code></td>
<td><span class="status-badge status-<%= inc.status %>"><%= inc.status %></span></td>
<td><%= inc.impact || 'none' %></td>
<td><%- inc.visible ? '<span class="yes">' + tr('common.yes') + '</span>' : '<span class="no">' + tr('common.no') + '</span>' %></td>
<td><%= inc.starts_at %></td>
<td class="actions">
<a href="/admin/incidents/<%= inc.id %>/edit" class="btn btn-sm"><%= tr('common.edit') %></a>
<form action="/admin/incidents/<%= inc.id %>?_method=DELETE" method="post" class="delete-form" onsubmit="return confirm('<%= tr('incidents.confirmDelete') %>')">
<button type="submit" class="btn btn-sm btn-danger"><%= tr('common.delete') %></button>
</form>
</td>
</tr>
<% }) %>
</tbody>
</table>
</div>
<% } %>
</main>
</div>
<script src="/js/admin.js"></script>

<%- include("../partials/_csrf"); %>
<script>
(function() {
  var token = document.getElementById("csrfToken");
  if (token) {
    var forms = document.querySelectorAll("form[method=\"post\"]");
    for (var i = 0; i < forms.length; i++) {
      if (!forms[i].querySelector("input[name=\"_csrf\"]")) {
        var input = document.createElement("input");
        input.type = "hidden";
        input.name = "_csrf";
        input.value = token.value;
        forms[i].appendChild(input);
      }
    }
  }
})();
</script>
</body>
</html>
