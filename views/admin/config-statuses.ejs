<%# i18n (5.0.0): every user-visible string goes through `t` (res.locals). The
    fallback keeps standalone rendering working when a harness renders the
    template without the session middleware. %>
<% const tr = (typeof t === 'function') ? t : function (k) { return k; }; %>
<% const pt = (typeof pageTitle === 'function') ? pageTitle : function (x) { return x; }; %>
<% const loc = (typeof locale === 'string' && locale) ? locale : 'en'; %>
<!DOCTYPE html>
<html lang="<%= loc %>">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= pt(title) %> - <%= tr('common.adminTitle') %></title>
<link rel="stylesheet" href="/css/admin.css">
<script>document.addEventListener('DOMContentLoaded',function(){document.body.classList.add('dark');});</script>
</head>
<body>
<div class="admin-layout">
<%- include('../partials/_sidebar'); %>
<main class="admin-main">
<div class="admin-header">
<h1><%= pt(title) %></h1>
<% if (message) { %>
<div class="flash flash-<%= messageType %>"><%= message %></div>
<% } %>
</div>

<div class="card">
<div class="card-header-row">
<h2><%= type === 'component' ? tr('configStatuses.manageComponent') : tr('configStatuses.manageIncident') %></h2>
<button class="btn btn-primary" onclick="document.getElementById('addForm').style.display='block'">
<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
<%= tr('configStatuses.add') %>
</button>
</div>

<!-- Add form (hidden by default) -->
<div id="addForm" style="display:none;" class="card">
<h3 style="font-size:15px;margin-bottom:16px;"><%= tr('configStatuses.addEdit') %></h3>
<form action="/admin/config/<%= type %>-statuses" method="post">
<div class="form-row">
<div class="form-group">
<label><%= tr('configStatuses.keyLabel') %></label>
<input type="text" name="value" placeholder="<%= tr('configStatuses.keyPlaceholder') %>" required>
</div>
<div class="form-group">
<label><%= tr('configStatuses.labelLabel') %></label>
<input type="text" name="label" placeholder="<%= tr('configStatuses.labelPlaceholder') %>" required>
</div>
</div>
<div class="form-row">
<div class="form-group">
<label><%= tr('configStatuses.colorLabel') %></label>
<input type="text" name="color" value="#10b981" placeholder="#10b981">
</div>
<div class="form-group">
<label><%= tr('components.fieldPosition') %></label>
<input type="number" name="position" value="0" min="0">
</div>
</div>
<div class="form-actions">
<button type="submit" class="btn btn-primary"><%= tr('common.save') %></button>
<button type="button" class="btn" onclick="document.getElementById('addForm').style.display='none'"><%= tr('common.cancel') %></button>
</div>
</form>
</div>

<!-- Statuses table -->
<div class="table-container" style="margin-top:20px;">
<table class="admin-table">
<thead>
<tr>
<th><%= tr('configStatuses.colorLabel') %></th>
<th><%= tr('apiKeys.thKey') %></th>
<th><%= tr('configStatuses.thLabel') %></th>
<th><%= tr('components.thPosition') %></th>
<th><%= tr('notif.thType') %></th>
<th><%= tr('components.thActions') %></th>
</tr>
</thead>
<tbody>
<% if (statuses.length === 0) { %>
<tr><td colspan="6" class="empty-cell"><%= tr('configStatuses.none') %></td></tr>
<% } else { %>
<% statuses.forEach(s => { %>
<tr>
<td>
<span style="display:inline-block;width:20px;height:20px;border-radius:4px;background:<%= s.color %>;border:1px solid var(--border);"></span>
</td>
<td><code><%= s.value %></code></td>
<td><%= s.label %></td>
<td><%= s.position %></td>
<td><% if (s.is_system) { %><span class="status-badge status-operational"><%= tr('configStatuses.system') %></span><% } else { %><span class="status-badge status-investigating"><%= tr('configStatuses.custom') %></span><% } %></td>
<td>
<div class="actions">
<form action="/admin/config/<%= type %>-statuses" method="post" style="display:inline;" class="edit-form">
<input type="hidden" name="value" value="<%= s.value %>">
<input type="hidden" name="label" value="<%= s.label %>">
<input type="hidden" name="color" value="<%= s.color %>">
<input type="hidden" name="position" value="<%= s.position %>">
<button type="submit" class="btn btn-sm" title="<%= tr('common.edit') %>" style="padding:4px 8px;font-size:12px;">✏️</button>
</form>
<% if (!s.is_system) { %>
<form action="/admin/config/<%= type %>-statuses/<%= s.value %>" method="post" style="display:inline;" class="delete-form">
<input type="hidden" name="_method" value="DELETE">
<button type="submit" class="btn btn-sm btn-danger" title="<%= tr('common.delete') %>" onclick="return confirm('<%= tr('configStatuses.confirmDelete') %>')">🗑️</button>
</form>
<% } else { %>
<span style="color:var(--text-muted);font-size:12px;"><%= tr('configStatuses.protected') %></span>
<% } %>
</div>
</td>
</tr>
<% }); %>
<% } %>
</tbody>
</table>
</div>
</div>
</main>
</div>
<script src="/js/admin.js"></script>
<script>
document.querySelectorAll('.edit-form').forEach(function(form) {
  form.addEventListener('submit', function(e) {
    e.preventDefault();
    var fd = new FormData(form);
    var formEl = document.getElementById('addForm');
    formEl.style.display = 'block';
    formEl.querySelector('input[name="value"]').value = fd.get('value');
    formEl.querySelector('input[name="label"]').value = fd.get('label');
    formEl.querySelector('input[name="color"]').value = fd.get('color');
    formEl.querySelector('input[name="position"]').value = fd.get('position');
    form.remove();
    formEl.scrollIntoView({ behavior: 'smooth' });
  });
});
</script>

<%- include("../partials/_csrf"); %>
<script>
(function() {
  var token = document.getElementById('csrfToken');
  if (token && token.value) {
    var forms = document.querySelectorAll('form[method="post"], form[method="POST"]');
    for (var i = 0; i < forms.length; i++) {
      if (!forms[i].querySelector('input[name="_csrf"]')) {
        var input = document.createElement('input');
        input.type = 'hidden';
        input.name = '_csrf';
        input.value = token.value;
        forms[i].appendChild(input);
      }
    }
  }
})();
</script>
</body>
</html>
