<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title %> - StatusFe Admin</title>
<link rel="stylesheet" href="/css/admin.css">
<script>document.addEventListener('DOMContentLoaded',function(){document.body.classList.add('dark');});</script>
</head>
<body>
<div class="admin-layout">
<%- include('../partials/_sidebar'); %>
<main class="admin-main">
<div class="admin-header"><h1><%= title %></h1>
<% if (message) { %><div class="flash flash-<%= messageType %>"><%= message %></div><% } %>
</div>
<div class="card">
<h3>Create organization</h3>
<form method="post" action="/admin/organizations">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<div class="form-row">
<div class="form-group"><label>Name</label><input type="text" name="name" required placeholder="Acme Corp"></div>
<div class="form-group"><label>Slug</label><input type="text" name="slug" required pattern="[a-z0-9-]{1,64}" placeholder="acme"></div>
</div>
<div class="form-group">
<label>Members (users)</label>
<div class="component-checkboxes">
<% users.forEach(u => { %>
<label class="component-checkbox"><input type="checkbox" name="member_ids" value="<%= u.id %>"> <%= u.name %> &lt;<%= u.email %>&gt;</label>
<% }) %>
</div>
</div>
<button type="submit" class="btn btn-primary">Create</button>
</form>
</div>
<div class="card">
<h3>Self-service registration</h3>
<p style="font-size:13px;color:var(--text-muted);">When enabled, anyone can create their own account, organization and status page from <code>/register</code>. Off by default.</p>
<form method="post" action="/admin/organizations/self-registration">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
<input type="checkbox" name="enabled" value="on" <%= (typeof selfRegistration !== 'undefined' && selfRegistration) ? 'checked' : '' %>>
Public registration enabled
</label>
<button type="submit" class="btn btn-sm" style="margin-top:8px;">Save</button>
</form>
</div>
<div class="card">
<h3>Organizations (<%= orgs.length %>)</h3>
<table>
<thead><tr><th>Name</th><th>Slug</th><th>Members</th><th>Plan &amp; usage</th><th>Edit members</th><th></th></tr></thead>
<tbody>
<% if (orgs.length === 0) { %><tr><td colspan="6">No organizations yet.</td></tr><% } %>
<% orgs.forEach(o => { %>
<tr>
<td><strong><%= o.name %></strong></td>
<td><code><%= o.slug %></code></td>
<td><%= memberCounts[o.id] || 0 %></td>
<td>
<div style="font-size:12px;margin-bottom:6px;">
<strong><%= planByOrg[o.id] || 'custom' %></strong>
<form method="post" action="/admin/organizations/<%= o.id %>/plan" style="display:inline;">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<select name="plan" onchange="this.form.submit()" style="font-size:12px;padding:2px 6px;">
<% planKeys.forEach(k => { %><option value="<%= k %>" <%= (planByOrg[o.id] === k) ? 'selected' : '' %>><%= k %></option><% }); %>
<option value="custom" disabled <%= planByOrg[o.id] === 'custom' ? 'selected' : '' %>>custom</option>
</select>
</form>
</div>
<%
  const u = usageByOrg[o.id] || {};
  const l = limitsByOrg[o.id] || {};
  const rows = [['pages','maxPages'],['keys','maxApiKeys'],['comp','maxComponents'],['subs','maxSubscribers']];
%>
<% rows.forEach(([label, key]) => {
  const used = u[key] || 0; const cap = l[key];
  const pct = cap ? Math.min(100, Math.round((used / cap) * 100)) : 0;
  const warn = cap && used >= cap * 0.8;
%>
<div style="font-size:11px;color:<%= warn ? '#ef4444' : 'var(--text-muted)' %>;">
<%= label %>: <%= used %>/<%= cap ? cap : '∞' %>
</div>
<% }); %>
<details style="font-size:11px;margin-top:4px;">
<summary style="cursor:pointer;">edit limits</summary>
<form method="post" action="/admin/organizations/<%= o.id %>/limits" style="display:grid;grid-template-columns:1fr 1fr;gap:4px;margin-top:4px;">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<input type="number" name="maxPages" min="1" placeholder="pages" value="<%= l.maxPages || '' %>" style="width:100%;font-size:11px;padding:2px 4px;">
<input type="number" name="maxApiKeys" min="1" placeholder="keys" value="<%= l.maxApiKeys || '' %>" style="width:100%;font-size:11px;padding:2px 4px;">
<input type="number" name="maxComponents" min="1" placeholder="comp" value="<%= l.maxComponents || '' %>" style="width:100%;font-size:11px;padding:2px 4px;">
<input type="number" name="maxSubscribers" min="1" placeholder="subs" value="<%= l.maxSubscribers || '' %>" style="width:100%;font-size:11px;padding:2px 4px;">
<button type="submit" class="btn btn-sm" style="grid-column:span 2;">Save limits (empty = unlimited)</button>
</form>
</details>
</td>
<td>
<form method="post" action="/admin/organizations/<%= o.id %>" style="display:flex;gap:6px;align-items:center;">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<select name="member_ids" multiple size="3" style="min-width:180px;">
<% users.forEach(u => { %>
<option value="<%= u.id %>" <%= members[o.id].some(m => m.id === u.id) ? 'selected' : '' %>><%= u.name %></option>
<% }) %>
</select>
<button type="submit" class="btn btn-sm">Save members</button>
</form>
</td>
<td>
<form method="post" action="/admin/organizations/<%= o.id %>/invite" style="display:flex;gap:6px;align-items:center;margin-bottom:6px;">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<input type="email" name="email" placeholder="teammate@company.com" required style="min-width:170px;padding:4px 8px;">
<button type="submit" class="btn btn-sm">Invite</button>
</form>
<% ((typeof invites !== 'undefined' && invites[o.id]) || []).forEach(inv => { %>
<div style="font-size:12px;color:var(--text-muted);">
<%= inv.email || '(no email)' %> ·
<% if (inv.accepted_at) { %>accepted<% } else { %>pending · <form method="post" action="/admin/organizations/invites/<%= inv.id %>/revoke" style="display:inline;"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" style="background:none;border:none;color:#ef4444;cursor:pointer;font-size:12px;">revoke</button></form><% } %>
</div>
<% }); %>
<form method="post" action="/admin/organizations/<%= o.id %>/delete" onsubmit="return confirm('Delete organization? Pages will remain without an org.')">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<button type="submit" class="btn btn-sm">Delete</button>
</form>
</td>
</tr>
<% }) %>
</tbody>
</table>
</div>
</main>
</div>
</body>
</html>
