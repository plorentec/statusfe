<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title %> - StatusFe Admin</title>
<link rel="stylesheet" href="/css/admin.css">
<script>document.addEventListener('DOMContentLoaded',function(){document.body.classList.add('dark');});</script>
</head>
<body>
<div class="admin-layout">
<%- include('../partials/_sidebar'); %>
<main class="admin-main">
<div class="admin-header"><h1><%= title %></h1>
<%
// 4.0.0: the channel routes emit their own ?msg= codes. session.js only maps the
// codes that existed before this feature, so the readable text lives here.
var FLASH_TEXT = {
  channel_created: 'Notification channel created.',
  channel_updated: 'Notification channel updated.',
  channel_deleted: 'Notification channel deleted.',
  channel_toggled: 'Notification channel enabled state changed.',
  channel_invalid: 'That channel is incomplete or invalid — fill in the required fields for its type.',
  channel_notfound: 'That notification channel does not exist any more.',
  channel_test_ok: 'Test message sent successfully!',
  channel_test_failed: 'Test message failed.'
};
var flashText = message ? (FLASH_TEXT[message] || message) : null;
%>
<% if (flashText) { %>
<div class="flash flash-<%= messageType %>"><%= flashText %><% if (testError) { %> — <%= testError %><% } %></div>
<% } %>
</div>

<div class="card">
<h3 style="font-size:16px;font-weight:600;margin-bottom:16px;padding-bottom:12px;border-bottom:1px solid var(--border);">
<%= channel && channel.id ? 'Edit Channel' : 'Add Channel' %>
</h3>
<%
if (!channel) { channel = { id: null, type: 'telegram', name: '', events: [], enabled: 1, config: {}, has_secret: {} }; }
var cfg = channel.config || {};
var hasSecret = channel.has_secret || {};
var chEvents = channel.events || [];
%>
<form class="admin-form" action="<%= channel.id ? '/admin/channels/' + channel.id : '/admin/channels' %>" method="post">
<% if (channel.id) { %><input type="hidden" name="_method" value="PUT"><% } %>

<div class="form-row">
<div class="form-group">
<label for="type">Type *</label>
<select id="type" name="type" required onchange="sfChannelType(this.value)">
<% channelTypes.forEach(function(t) { %>
<option value="<%= t %>" <%= channel.type === t ? 'selected' : '' %>><%= t %></option>
<% }); %>
</select>
</div>
<div class="form-group">
<label for="name">Name *</label>
<input type="text" id="name" name="name" value="<%= channel.name || '' %>" placeholder="Ops Telegram" required>
</div>
</div>

<div data-channel-type="telegram">
<div class="form-row">
<div class="form-group">
<label for="bot_token">Bot Token<%= hasSecret.bot_token ? '' : ' *' %></label>
<input type="password" id="bot_token" name="bot_token" autocomplete="new-password" placeholder="<%= hasSecret.bot_token ? 'Leave blank to keep the current value' : '123456:ABC-DEF...' %>">
</div>
<div class="form-group">
<label for="chat_id">Chat ID *</label>
<input type="text" id="chat_id" name="chat_id" value="<%= cfg.chat_id || '' %>" placeholder="-1001234567890">
</div>
</div>
</div>

<div data-channel-type="slack">
<div class="form-group">
<label for="webhook_url_slack">Slack Webhook URL<%= hasSecret.webhook_url ? '' : ' *' %></label>
<input type="password" id="webhook_url_slack" name="webhook_url" autocomplete="new-password" placeholder="<%= hasSecret.webhook_url ? 'Leave blank to keep the current value' : 'https://hooks.slack.com/services/T000/B000/XXXX' %>">
</div>
</div>

<div data-channel-type="discord">
<div class="form-group">
<label for="webhook_url_discord">Discord Webhook URL<%= hasSecret.webhook_url ? '' : ' *' %></label>
<input type="password" id="webhook_url_discord" name="webhook_url" autocomplete="new-password" placeholder="<%= hasSecret.webhook_url ? 'Leave blank to keep the current value' : 'https://discord.com/api/webhooks/000/XXXX' %>">
</div>
</div>

<div data-channel-type="webhook">
<div class="form-group">
<label for="url">Webhook URL<%= hasSecret.url ? '' : ' *' %></label>
<input type="password" id="url" name="url" autocomplete="new-password" placeholder="<%= hasSecret.url ? 'Leave blank to keep the current value' : 'https://example.com/statusfe-hook' %>">
</div>
<div class="form-group">
<label for="secret">Signing Secret (optional)</label>
<input type="password" id="secret" name="secret" autocomplete="new-password" placeholder="<%= hasSecret.secret ? 'Leave blank to keep the current value' : 'Adds X-StatusFe-Signature: sha256=...' %>">
</div>
</div>

<div class="form-group">
<label>Events</label>
<div class="component-checkboxes">
<% channelEvents.forEach(function(ev) { %>
<label class="component-checkbox">
<input type="checkbox" name="events" value="<%= ev %>" <%= chEvents.indexOf(ev) !== -1 ? 'checked' : '' %>>
<%= ev %>
</label>
<% }); %>
</div>
<p class="text-muted" style="margin-top:8px;">No event selected = every event is sent.</p>
</div>

<div class="form-group checkbox-group">
<label>
<input type="checkbox" name="enabled" value="1" <%= Number(channel.enabled) === 1 ? 'checked' : '' %>>
Enabled
</label>
</div>

<div class="form-actions">
<button type="submit" class="btn btn-primary"><%= channel.id ? 'Save Channel' : 'Add Channel' %></button>
<% if (channel.id) { %><a href="/admin/channels" class="btn">Cancel</a><% } %>
</div>
</form>
<p class="text-muted" style="margin-top:8px;">Stored secrets are never shown again. Leave a secret field blank to keep the value already saved.</p>
</div>

<div class="card" style="margin-top:20px;">
<h3 style="font-size:16px;font-weight:600;margin-bottom:16px;padding-bottom:12px;border-bottom:1px solid var(--border);">Configured Channels <span class="text-muted" style="font-size:13px;">— <%= channels.length %></span></h3>
<% if (channels.length > 0) { %>
<div class="table-container">
<table class="admin-table">
<thead>
<tr><th>Type</th><th>Name</th><th>Events</th><th>Enabled</th><th>Actions</th></tr>
</thead>
<tbody>
<% channels.forEach(function(ch) { %>
<tr>
<td><strong><%= ch.type %></strong></td>
<td><%= ch.name %></td>
<td><%= (ch.events && ch.events.length) ? ch.events.join(', ') : 'All events' %></td>
<td><span class="<%= Number(ch.enabled) === 1 ? 'yes' : 'no' %>"><%= Number(ch.enabled) === 1 ? 'Yes' : 'No' %></span></td>
<td class="actions">
<a class="btn btn-sm" href="/admin/channels/<%= ch.id %>/edit">Edit</a>
<form action="/admin/channels/<%= ch.id %>/test" method="post" style="display:inline;">
<button type="submit" class="btn btn-sm">Test</button>
</form>
<form action="/admin/channels/<%= ch.id %>/toggle" method="post" style="display:inline;">
<button type="submit" class="btn btn-sm"><%= Number(ch.enabled) === 1 ? 'Disable' : 'Enable' %></button>
</form>
<form action="/admin/channels/<%= ch.id %>/delete" method="post" class="delete-form" style="display:inline;">
<button type="submit" class="btn btn-sm btn-danger">Delete</button>
</form>
</td>
</tr>
<% }); %>
</tbody>
</table>
</div>
<% } else { %>
<p class="text-muted">No notification channels configured. Email notifications still work as before.</p>
<% } %>
</div>
</main>
</div>
<script src="/js/admin.js"></script>
<script>
// Only the fields of the selected type are submitted: inputs inside the hidden
// blocks are DISABLED (display:none alone still submits them, and the Slack and
// Discord blocks share the `webhook_url` field name).
function sfChannelType(type) {
  var blocks = document.querySelectorAll('[data-channel-type]');
  for (var i = 0; i < blocks.length; i++) {
    var active = blocks[i].getAttribute('data-channel-type') === type;
    blocks[i].style.display = active ? '' : 'none';
    var inputs = blocks[i].querySelectorAll('input');
    for (var j = 0; j < inputs.length; j++) inputs[j].disabled = !active;
  }
}
document.addEventListener('DOMContentLoaded', function () {
  var sel = document.getElementById('type');
  if (sel) sfChannelType(sel.value);
});
</script>
<%- include("../partials/_csrf"); %>
<script>
(function() {
  var token = document.getElementById('csrfToken');
  if (token) {
    var forms = document.querySelectorAll('form[method="post"]');
    for (var i = 0; i < forms.length; i++) {
      if (!forms[i].querySelector('input[name="_csrf"]')) {
        var input = document.createElement('input');
        input.type = 'hidden';
        input.name = '_csrf';
        input.value = token.value;
        forms[i].appendChild(input);
      }
    }
  }
})();
</script>
</body>
</html>
