<%# i18n (5.0.0): every user-visible string goes through `t` (res.locals); the
    fallback keeps standalone rendering working. %>
<% const tr = (typeof t === 'function') ? t : function (k) { return k; }; %>
<% const pt = (typeof pageTitle === 'function') ? pageTitle : function (x) { return x; }; %>
<% const loc = (typeof locale === 'string' && locale) ? locale : 'en'; %>
<!DOCTYPE html>
<html lang="<%= loc %>">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= pt(title) %> - <%= tr('common.adminTitle') %></title>
<link rel="stylesheet" href="/css/admin.css">
<script>document.addEventListener('DOMContentLoaded',function(){document.body.classList.add('dark');});</script>
</head>
<body>
<div class="admin-layout">
<%- include('../partials/_sidebar'); %>
<main class="admin-main">
<div class="admin-header">
<h1><%= pt(title) %></h1>
<% if (message) { %>
<div class="flash flash-<%= messageType %>"><%= message %></div>
<% } %>
</div>

<div class="doc-tabs">
<button class="doc-tab-btn active" data-tab="internal"><%= tr('notif.tabInternal') %></button>
<button class="doc-tab-btn" data-tab="email"><%= tr('notif.tabEmail') %></button>
</div>

<!-- Internal Notifications Tab -->
<div class="doc-tab-content active" id="tab-internal">
<div class="card-header-row">
<h2><%= tr('notif.history') %></h2>
<% if (hasNotifications) { %>
<form action="/admin/notifications/read-all" method="post">
<button type="submit" class="btn btn-sm"><%= tr('notif.markAllRead') %></button>
</form>
<% } %>
</div>

<% if (!hasNotifications) { %>
<div class="card"><p class="text-muted"><%= tr('notif.empty') %></p></div>
<% } else { %>
<div class="table-container">
<table class="admin-table">
<thead>
<tr>
<th><%= tr('notif.thType') %></th>
<th><%= tr('notif.thTitle') %></th>
<th><%= tr('notif.thMessage') %></th>
<th><%= tr('notif.thDate') %></th>
<th><%= tr('components.thActions') %></th>
</tr>
</thead>
<tbody>
<% notifications.forEach(n => { %>
<tr class="<%= n.is_read ? '' : 'unread' %>">
<td><span class="notif-type notif-<%= n.type %>"><% 
  const icons = {
    status_change: '&#x1f504;',
    incident_created: '&#x26a0;&#xfe0f;',
    incident_updated: '&#x270f;&#xfe0f;',
    component_created: '&#x2795;',
    component_updated: '&#x270f;&#xfe0f;',
    component_deleted: '&#x1f5d1;&#xfe0f;',
    page_created: '&#x2b1c;',
    page_updated: '&#x270f;&#xfe0f;',
    page_deleted: '&#x1f5d1;&#xfe0f;',
    maintenance_created: '&#x1f553;',
    maintenance_updated: '&#x270f;&#xfe0f;',
    maintenance_deleted: '&#x1f5d1;&#xfe0f;'
  };
%><%- icons[n.type] || '&#x1f514;' %> <%= n.type %></span></td>
<td><strong><%= n.title %></strong></td>
<td><%= (n.message || '').substring(0, 150) %></td>
<td><%= n.created_at %></td>
<td class="actions">
<% if (!n.is_read) { %>
<form action="/admin/notifications/<%= n.id %>/read" method="post">
<button type="submit" class="btn btn-sm"><%= tr('notif.markRead') %></button>
</form>
<% } %>
<form action="/admin/notifications/<%= n.id %>?_method=DELETE" method="post" class="delete-form">
<button type="submit" class="btn btn-sm btn-danger"><%= tr('common.delete') %></button>
</form>
</td>
</tr>
<% }) %>
</tbody>
</table>
</div>
<% } %>
</div>

<!-- Email Settings Tab -->
<div class="doc-tab-content" id="tab-email">
<div class="card">
<h2 style="font-size: 16px; font-weight: 600; margin-bottom: 20px; padding-bottom: 12px; border-bottom: 1px solid var(--border);"><%= tr('email.smtpTitle') %></h2>
<form class="admin-form" action="/admin/email-settings" method="post">

<div class="form-row">
<div class="form-group">
<label for="smtp_from"><%= tr('email.fromEmail') %></label>
<input type="email" id="smtp_from" name="smtp_from" value="<%= smtp.from || '' %>" placeholder="noreply@example.com" required>
</div>
<div class="form-group">
<label for="smtp_from_name"><%= tr('email.fromName') %></label>
<input type="text" id="smtp_from_name" name="smtp_from_name" value="<%= smtp.from_name || 'StatusFe' %>" placeholder="StatusFe">
</div>
</div>

<div class="form-row">
<div class="form-group">
<label for="smtp_host"><%= tr('email.host') %></label>
<input type="text" id="smtp_host" name="smtp_host" value="<%= smtp.host || '' %>" placeholder="smtp.gmail.com" required>
</div>
<div class="form-group">
<label for="smtp_port"><%= tr('email.port') %></label>
<input type="number" id="smtp_port" name="smtp_port" value="<%= smtp.port || '587' %>" placeholder="587">
</div>
</div>

<div class="form-row">
<div class="form-group">
<label for="smtp_user"><%= tr('email.username') %></label>
<input type="text" id="smtp_user" name="smtp_user" value="<%= smtp.user || '' %>" placeholder="user@example.com">
</div>
<div class="form-group">
<label for="smtp_pass"><%= tr('email.password') %></label>
<input type="password" id="smtp_pass" name="smtp_pass" placeholder="<%= tr('channels.keepCurrent') %>">
</div>
</div>

<div class="form-group checkbox-group">
<label>
<input type="checkbox" name="smtp_secure" value="1" <%= (smtp.secure === 'true' || smtp.secure === '1' || smtp.secure === true) ? 'checked' : '' %>>
<%= tr('email.useTls') %>
</label>
</div>

<div class="form-actions">
<button type="submit" class="btn btn-primary"><%= tr('email.saveSmtp') %></button>
</div>
</form>
</div>

<div class="card">
<h2 style="font-size: 16px; font-weight: 600; margin-bottom: 16px; padding-bottom: 12px; border-bottom: 1px solid var(--border);"><%= tr('email.testTitle') %></h2>
<div class="form-group">
<label for="test_to"><%= tr('email.testTo') %></label>
<input type="email" id="test_to" placeholder="test@example.com">
</div>
<div class="form-actions" style="border: none; padding: 0; margin-top: 12px;">
<button class="btn btn-primary" onclick="testEmail()"><%= tr('email.sendTest') %></button>
</div>
<div id="testResult" style="margin-top: 12px;"></div>
</div>
</div>

</main>
</div>
<script src="/js/admin.js"></script>
<script>
// 5.0.0: strings built by this inline script come from the dictionary, already
// resolved for THIS user's locale (same pattern as the components list).
window.SF_I18N = <%- JSON.stringify({
  enterAddress: tr('email.enterAddress'),
  sending: tr('email.sending'),
  testOk: tr('email.testOk'),
  failed: tr('email.failed'),
  unknownError: tr('email.unknownError'),
  errorPrefix: tr('email.errorPrefix')
}) %>;
</script>
<script>
var I18N = window.SF_I18N || {};
// Tab switching
document.querySelectorAll('.doc-tab-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.doc-tab-btn').forEach(b => b.classList.remove('active'));
    document.querySelectorAll('.doc-tab-content').forEach(c => c.classList.remove('active'));
    btn.classList.add('active');
    document.getElementById('tab-' + btn.dataset.tab).classList.add('active');
  });
});

function testEmail() {
  const to = document.getElementById('test_to').value;
  if (!to) { alert(I18N.enterAddress || ''); return; }
  const result = document.getElementById('testResult');
  result.innerHTML = '<p class="text-muted">' + (I18N.sending || '') + '</p>';
  fetch('/admin/email-settings/test', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': document.getElementById('csrfToken').value },
    body: JSON.stringify({ to: to })
  })
  .then(r => r.json())
  .then(data => {
    if (data.ok) {
      result.innerHTML = '<p style="color: var(--success); font-size: 14px;">' + (I18N.testOk || '') + '</p>';
    } else {
      result.innerHTML = '<p style="color: var(--danger); font-size: 14px;">' + (I18N.failed || '') + ' ' + (data.error || I18N.unknownError) + '</p>';
    }
  })
  .catch(err => {
    result.innerHTML = '<p style="color: var(--danger); font-size: 14px;">' + (I18N.errorPrefix || '') + ' ' + err.message + '</p>';
  });
}
</script>

<%- include("../partials/_csrf"); %>
<script>
(function() {
  var token = document.getElementById("csrfToken");
  if (token) {
    var forms = document.querySelectorAll("form[method=\"post\"]");
    for (var i = 0; i < forms.length; i++) {
      if (!forms[i].querySelector("input[name=\"_csrf\"]")) {
        var input = document.createElement("input");
        input.type = "hidden";
        input.name = "_csrf";
        input.value = token.value;
        forms[i].appendChild(input);
      }
    }
  }
})();
</script>
</body>
</html>
