<%# i18n (5.0.0): every user-visible string goes through `t` (res.locals). The
    fallback keeps standalone rendering working when a harness renders the
    template without the session middleware. %>
<% const tr = (typeof t === 'function') ? t : function (k) { return k; }; %>
<% const pt = (typeof pageTitle === 'function') ? pageTitle : function (x) { return x; }; %>
<% const loc = (typeof locale === 'string' && locale) ? locale : 'en'; %>
<!DOCTYPE html>
<html lang="<%= loc %>">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= pt(title) %> - <%= tr('common.adminTitle') %></title>
<link rel="stylesheet" href="/css/admin.css">
<style>
.status-upcoming { background: rgba(99,102,241,0.2); color: #818cf8; }
.status-ongoing { background: rgba(245,158,11,0.2); color: #fbbf24; }
.status-completed { background: rgba(16,185,129,0.2); color: #34d399; }
</style>
<script>document.addEventListener('DOMContentLoaded',function(){document.body.classList.add('dark');});</script>
</head>
<body>
<div class="admin-layout">
<%- include('../partials/_sidebar'); %>
<main class="admin-main">
<div class="admin-header"><h1><%= pt(title) %></h1>
<% if (message) { %><div class="flash flash-<%= messageType %>"><%= message %></div><% } %>
</div>

<div class="card-header-row">
<h2><%= tr('maintenance.windows') %></h2>
<a href="/admin/maintenance/new" class="btn btn-primary">+ <%= tr('maintenance.newWindow') %></a>
</div>

<% if (windows.length === 0) { %>
<div class="card"><p class="empty-state"><%= tr('maintenance.none') %></p></div>
<% } else { %>
<div class="table-container">
<table class="admin-table">
<thead><tr><th><%= tr('notif.thTitle') %></th><th><%= tr('subs.thPage') %></th><th><%= tr('incidents.component') %></th><th><%= tr('components.thStatus') %></th><th><%= tr('maintenance.startsAt') %></th><th><%= tr('maintenance.endsAt') %></th><th><%= tr('components.thActions') %></th></tr></thead>
<tbody>
<% windows.forEach(w => { %>
<tr>
<td><strong><%= w.title %></strong><br><small class="text-muted"><%= (w.description || '').substring(0, 50) %><%= (w.description || '').length > 50 ? '...' : '' %></small></td>
<td><code><%= w.page_id ? w.page_id.substring(0,8) + '...' : '-' %></code></td>
<%# 5.2.0: igual que en suscriptores, el marcado va en la plantilla; dentro de
    una cadena con <%= %> se escapaba y se veia literal. %>
<td><% if (w.component_id) { %><%= w.component_id.substring(0,8) %>...<% } else { %><span class="text-muted"><%= tr('maintenance.allComponents') %></span><% } %></td>
<td><span class="status-badge status-<%= w.status %>"><%= w.status %></span></td>
<td><%= w.starts_at %></td>
<td><%= w.ends_at %></td>
<td class="actions">
<a href="/admin/maintenance/<%= w.id %>/edit" class="btn btn-sm"><%= tr('common.edit') %></a>
<form action="/admin/maintenance/<%= w.id %>?_method=DELETE" method="post" class="delete-form" onsubmit="return confirm('<%= tr('maintenance.confirmDelete') %>')">
<button type="submit" class="btn btn-sm btn-danger"><%= tr('common.delete') %></button>
</form>
</td>
</tr>
<% }) %>
</tbody>
</table>
</div>
<% } %>
</main>
</div>
<script src="/js/admin.js"></script>

<%- include("../partials/_csrf"); %>
<script>
(function() {
  var token = document.getElementById("csrfToken");
  if (token) {
    var forms = document.querySelectorAll("form[method=\"post\"]");
    for (var i = 0; i < forms.length; i++) {
      if (!forms[i].querySelector("input[name=\"_csrf\"]")) {
        var input = document.createElement("input");
        input.type = "hidden";
        input.name = "_csrf";
        input.value = token.value;
        forms[i].appendChild(input);
      }
    }
  }
})();
</script>
</body>
</html>
