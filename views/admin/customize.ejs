<%# i18n (5.0.0): every user-visible string goes through `t` (res.locals). The
    fallback keeps standalone rendering working when a harness renders the
    template without the session middleware. 5.0.2: the language selector lives
    in this page (the sidebars no longer carry it). %>
<% const __loc = (typeof locale === 'string' && locale) ? locale : 'es'; %>
<% const __tr = (typeof t === 'function') ? t : function (k) { return k; }; %>
<% const __pt = (typeof pageTitle === 'function') ? pageTitle : function (x) { return x; }; %>
<!DOCTYPE html>
<html lang="<%= __loc %>">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= __pt(title) %> - <%= __tr('common.adminTitle') %></title>
<link rel="stylesheet" href="/css/admin.css">
<script>document.addEventListener('DOMContentLoaded',function(){document.body.classList.add('dark');});</script>
</head>
<body>
<div class="admin-layout">
<%- include('../partials/_sidebar'); %>
<main class="admin-main">
<div class="admin-header">
<h1><%= __pt(title) %></h1>
<% if (message) { %>
<div class="flash flash-<%= messageType %>"><%= message %></div>
<% } %>
</div>

<form action="/admin/customize" method="post">

<div class="card">
<h3 style="font-size:16px;font-weight:600;margin-bottom:16px;padding-bottom:12px;border-bottom:1px solid var(--border);"><%= __tr('customize.branding') %></h3>
<div class="form-row">
<div class="form-group">
<label for="logo_text"><%= __tr('customize.logoText') %></label>
<input type="text" id="logo_text" name="logo_text" value="<%= customization.logo_text %>">
</div>
<div class="form-group">
<label for="logo_color"><%= __tr('customize.logoColor') %></label>
<input type="color" id="logo_color" name="logo_color" value="<%= customization.logo_color %>" style="height:40px;">
</div>
</div>
<small class="text-muted"><%= __tr('customize.logoHelp') %></small>
</div>

<div class="card" style="margin-top:20px;" id="language">
<h4><%= __tr('nav.language') %></h4>
<p class="text-muted" style="margin-bottom:12px;"><%= __tr('nav.languageHelp') %></p>
<form method="post" action="/admin/locale">
<%- include("../partials/_csrf"); %>
<button type="submit" name="locale" value="es" class="btn <%= __loc === 'es' ? 'btn-primary' : '' %>" style="margin-right:8px;">Español</button>
<button type="submit" name="locale" value="en" class="btn <%= __loc === 'en' ? 'btn-primary' : '' %>">English</button>
<span class="text-muted" style="margin-left:10px;"><%= __tr('nav.languageCurrent') %>: <%= __loc.toUpperCase() %></span>
</form>
</div>

<div class="card" style="margin-top:20px;">
<h3 style="font-size:16px;font-weight:600;margin-bottom:16px;padding-bottom:12px;border-bottom:1px solid var(--border);"><%= __tr('customize.logoImage') %></h3>
<div id="logo_preview_wrap" style="margin-bottom:16px;<%= customization.logo_image ? '' : 'display:none;' %>">
<img id="logo_preview" src="<%= customization.logo_image ? String(customization.logo_image) : '' %>" alt="<%= __tr('customize.currentLogo') %>" style="max-height:64px;max-width:240px;background:#fff;padding:8px;border-radius:8px;border:1px solid var(--border);">
<div style="margin-top:8px;">
<button type="button" class="btn" id="logo_remove_btn"><%= __tr('customize.removeLogo') %></button>
<span id="logo_removed_note" style="display:none;margin-left:8px;color:#ef4444;"><%= __tr('customize.logoWillRemove') %></span>
</div>
</div>
<div class="form-row">
<div class="form-group">
<label for="logo_image_file"><%= __tr('customize.uploadImage') %></label>
<input type="file" id="logo_image_file" accept="image/png,image/svg+xml,image/webp,image/jpeg">
</div>
<div class="form-group">
<label>&nbsp;</label>
<button type="button" class="btn btn-primary" id="logo_upload_btn"><%= __tr('customize.uploadImage') %></button>
</div>
</div>
<input type="hidden" name="_logo_image_data" id="logo_image_data" value="">
<input type="hidden" name="_logo_image_remove" id="logo_image_remove" value="0">
<small class="text-muted"><%= __tr('customize.logoImageHelpPrefix') %> <em><%= __tr('customize.saveCustomization') %></em><%= __tr('customize.logoImageHelpSuffix') %> <span id="logo_js_error" style="color:#ef4444;"></span></small>
</div>

<div class="card" style="margin-top:20px;">
<h3 style="font-size:16px;font-weight:600;margin-bottom:16px;padding-bottom:12px;border-bottom:1px solid var(--border);"><%= __tr('customize.colors') %></h3>
<div class="form-row">
<div class="form-group">
<label for="primary_color"><%= __tr('customize.primaryColor') %></label>
<input type="color" id="primary_color" name="primary_color" value="<%= customization.primary_color %>" style="height:40px;">
</div>
<div class="form-group">
<label for="secondary_color"><%= __tr('customize.secondaryColor') %></label>
<input type="color" id="secondary_color" name="secondary_color" value="<%= customization.secondary_color %>" style="height:40px;">
</div>
</div>
<div class="form-row">
<div class="form-group">
<label for="bg_color"><%= __tr('customize.bgColor') %></label>
<input type="color" id="bg_color" name="bg_color" value="<%= customization.bg_color %>" style="height:40px;">
</div>
<div class="form-group">
<label for="text_color"><%= __tr('customize.textColor') %></label>
<input type="color" id="text_color" name="text_color" value="<%= customization.text_color %>" style="height:40px;">
</div>
</div>
<small class="text-muted"><%= __tr('customize.colorsHelpPrefix') %> <code>--sf-primary</code>/<code>--sf-secondary</code><%= __tr('customize.colorsHelpSuffix') %></small>
</div>

<div class="card" style="margin-top:20px;">
<h3 style="font-size:16px;font-weight:600;margin-bottom:16px;padding-bottom:12px;border-bottom:1px solid var(--border);"><%= __tr('customize.typography') %></h3>
<div class="form-row">
<div class="form-group">
<label for="font_family"><%= __tr('customize.fontFamily') %></label>
<input type="text" id="font_family" name="font_family" value="<%= customization.font_family %>" placeholder="-apple-system, BlinkMacSystemFont, sans-serif">
</div>
<div class="form-group">
<label for="border_radius"><%= __tr('customize.borderRadius') %></label>
<input type="number" id="border_radius" name="border_radius" value="<%= customization.border_radius %>" min="0" max="30">
</div>
</div>
</div>

<div class="form-actions" style="margin-top:20px;">
<button type="submit" class="btn btn-primary"><%= __tr('customize.saveCustomization') %></button>
<a href="/admin" class="btn"><%= __tr('common.cancel') %></a>
</div>

</form>

</main>
</div>
<script src="/js/admin.js"></script>

<%- include("../partials/_csrf"); %>
<script>
(function() {
  var token = document.getElementById("csrfToken");
  if (token) {
    var forms = document.querySelectorAll("form[method=\"post\"]");
    for (var i = 0; i < forms.length; i++) {
      if (!forms[i].querySelector("input[name=\"_csrf\"]")) {
        var input = document.createElement("input");
        input.type = "hidden";
        input.name = "_csrf";
        input.value = token.value;
        forms[i].appendChild(input);
      }
    }
  }
})();
</script>
<script>
// i18n (5.0.0): strings used from JS go through a JSON bridge — the dictionary
// values are plain text, the markup stays here.
window.SF_I18N = <%- JSON.stringify({
  chooseFile: __tr('customize.chooseFile'),
  unsupportedType: __tr('customize.unsupportedType'),
  fileTooLarge: __tr('customize.fileTooLarge'),
  readFailed: __tr('customize.readFailed')
}).replace(/</g, '\\u003c') %>;
</script>
<script>
// Logo upload: convert the picked file to a base64 data URI and carry it in a
// hidden field so the urlencoded form POST stays parser-free (no multipart).
(function() {
  var I18N = window.SF_I18N || {};
  var fmt = function (s, vars) {
    return String(s == null ? '' : s).replace(/\{(\w+)\}/g, function (m, k) { return vars[k] == null ? m : String(vars[k]); });
  };
  var file = document.getElementById('logo_image_file');
  var uploadBtn = document.getElementById('logo_upload_btn');
  var removeBtn = document.getElementById('logo_remove_btn');
  var dataInput = document.getElementById('logo_image_data');
  var removeInput = document.getElementById('logo_image_remove');
  var preview = document.getElementById('logo_preview');
  var previewWrap = document.getElementById('logo_preview_wrap');
  var note = document.getElementById('logo_removed_note');
  var err = document.getElementById('logo_js_error');
  if (!file || !uploadBtn || !dataInput || !removeInput) return;
  var MAX_CHARS = 200 * 1024; // must match the server-side cap
  var ALLOWED = ['image/png', 'image/jpeg', 'image/webp', 'image/svg+xml'];
  uploadBtn.addEventListener('click', function() {
    err.textContent = '';
    var f = file.files && file.files[0];
    if (!f) { err.textContent = I18N.chooseFile || ''; return; }
    if (ALLOWED.indexOf(f.type) === -1) {
      err.textContent = fmt(I18N.unsupportedType, { type: (f.type || 'unknown') });
      return;
    }
    var reader = new FileReader();
    reader.onload = function() {
      var uri = String(reader.result || '');
      if (uri.length > MAX_CHARS) {
        err.textContent = fmt(I18N.fileTooLarge, { size: Math.round(uri.length / 1024) });
        return;
      }
      dataInput.value = uri;
      removeInput.value = '0';
      if (note) note.style.display = 'none';
      if (preview && previewWrap) {
        preview.src = uri;
        previewWrap.style.display = 'block';
      }
    };
    reader.onerror = function() { err.textContent = I18N.readFailed || ''; };
    reader.readAsDataURL(f);
  });
  if (removeBtn) removeBtn.addEventListener('click', function() {
    err.textContent = '';
    dataInput.value = '';
    removeInput.value = '1';
    if (note) note.style.display = 'inline';
  });
})();
</script>
</body>
</html>
