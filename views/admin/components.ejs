<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title %> - StatusFe Admin</title>
<link rel="stylesheet" href="/css/admin.css">
<script>document.addEventListener('DOMContentLoaded',function(){document.body.classList.add('dark');});</script>
</head>
<body>
<div class="admin-layout">
<%- include('../partials/_sidebar'); %>
<main class="admin-main">
<div class="admin-header">
<h1><%= title %></h1>
<% if (message) { %>
<div class="flash flash-<%= messageType %>"><%= message %></div>
<% } %>
</div>

<% if (componentMode === 'list') { %>
<% const compCount = components.length; %>
<% /* --- helpers for sortable headers: the <a> is also the no-JS fallback --- */ %>
<% const curSort = /^(name|external_id|group|status|position|created)_(ASC|DESC)$/.exec(sortBy) || null; %>
<% const nextDir = col => (curSort && curSort[1] === col) ? (curSort[2] === 'ASC' ? 'DESC' : 'ASC') : (col === 'created' ? 'DESC' : 'ASC'); %>
<% const sortHref = col => '?' + (searchQuery ? 'q=' + encodeURIComponent(searchQuery) + '&amp;' : '') + 'sort=' + col + '_' + nextDir(col); %>
<% const arrowOf = col => (curSort && curSort[1] === col) ? (curSort[2] === 'ASC' ? '↑' : '↓') : '↕'; %>
<% const ariaOf = col => (curSort && curSort[1] === col) ? (curSort[2] === 'ASC' ? 'ascending' : 'descending') : 'none'; %>
<% const thTag = (col, label) => `<th class="sortable${curSort && curSort[1] === col ? ' sorted' : ''}" data-col="${col}" aria-sort="${ariaOf(col)}"><a href="${sortHref(col)}">${label} <span class="sort-arrow" aria-hidden="true">${arrowOf(col)}</span></a></th>`; %>
<% const asDate = v => (v instanceof Date ? v : new Date(v)); %>
<% const tsOf = v => { const t = asDate(v).getTime(); return isNaN(t) ? 0 : t; }; %>
<% const fmtDate = v => { const d = asDate(v); if (isNaN(d.getTime())) return String(v || ''); const p = n => String(n).padStart(2, '0'); return d.getFullYear() + '-' + p(d.getMonth() + 1) + '-' + p(d.getDate()) + ' ' + p(d.getHours()) + ':' + p(d.getMinutes()); }; %>
<div class="card-header-row">
<h2>All Components</h2>
<div style="display:flex;gap:8px;">
<button type="button" id="bulk-delete-btn" class="btn btn-danger" disabled>Delete Selected</button>
<a href="/admin/components/new" class="btn btn-primary">+ New Component</a>
</div>
</div>

<form id="componentListFilter" class="list-toolbar" method="get" action="/admin/components">
<div class="search-box">
<svg class="search-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.6-3.6"></path></svg>
<input type="text" class="search-input" id="componentSearchInput" name="q" value="<%= searchQuery %>" placeholder="Search by name, group, ID or description…" autocomplete="off" spellcheck="false" aria-label="Search components">
<button type="button" class="search-clear" id="componentSearchClear" title="Clear search" aria-label="Clear search"<% if (!searchQuery) { %> hidden<% } %>>&times;</button>
<input type="hidden" name="sort" id="componentSortInput" value="<%= sortBy %>">
</div>
<div class="list-meta" id="componentListMeta"><%= compCount + (compCount === 1 ? ' component' : ' components') %></div>
<noscript><button type="submit" class="btn btn-sm">Search</button></noscript>
</form>

<div class="table-container">
<table id="component-list-table" class="admin-table">
<thead>
<tr>
<th class="th-check"><input type="checkbox" id="select-all-checkbox" aria-label="Select all visible components"></th>
<%- thTag('name', 'Name') %>
<%- thTag('external_id', 'External ID') %>
<%- thTag('group', 'Group') %>
<%- thTag('status', 'Status') %>
<%- thTag('position', 'Position') %>
<%- thTag('created', 'Created') %>
<th class="th-actions">Actions</th>
</tr>
</thead>
<tbody>
<% if (components.length === 0) { %>
<tr><td colspan="8" class="empty-cell"><% if (searchQuery) { %>No components match <strong><%= searchQuery %></strong>. <a href="/admin/components">Clear the search</a>.<% } else { %>No components yet. <a href="/admin/components/new">Create your first component</a>.<% } %></td></tr>
<% } else { %>
<% components.forEach(c => {
  const compGroups = c.groups || [];
  const groupText = compGroups.length > 0 ? compGroups.map(g => g.name).join(', ') : (c.group_name || '-');
  const searchText = [c.name, c.description, c.external_id, c.group_name].concat(compGroups.map(g => g.name)).filter(Boolean).join(' ').toLowerCase();
  const createdTs = tsOf(c.created_at);
%>
<tr class="component-row" data-name="<%= c.name %>" data-external="<%= c.external_id || '' %>" data-group="<%= groupText === '-' ? '' : groupText %>" data-status="<%= c.status %>" data-pos="<%= Number(c.position) || 0 %>" data-ts="<%= createdTs %>" data-search="<%= searchText %>">
<td><input type="checkbox" name="component_ids" class="component-row-check" value="<%= c.id %>" aria-label="Select <%= c.name %>"></td>
<td><strong><%= c.name %></strong><br><small class="text-muted"><%= c.description || '' %></small></td>
<td><small><code><%= c.external_id || '-' %></code></small></td>
<td><%= groupText %></td>
<td><span class="status-badge status-<%= c.status %>"><%= c.status %></span></td>
<td><%= c.position %></td>
<td><time<% if (createdTs) { %> datetime="<%= new Date(createdTs).toISOString() %>"<% } %>><%= fmtDate(c.created_at) %></time></td>
<td class="actions">
<a href="/admin/components/<%= c.id %>/edit" class="btn btn-sm">Edit</a>
<form action="/admin/components/<%= c.id %>/status" method="post" class="inline-status-form" style="display:inline;">
<select name="status" onchange="this.form.submit()" style="font-size:12px;padding:2px 6px;border:1px solid var(--border);border-radius:4px;">
<option value="operational" <%= c.status === 'operational' ? 'selected' : '' %>>Operational</option>
<option value="degraded_performance" <%= c.status === 'degraded_performance' ? 'selected' : '' %>>Degraded</option>
<option value="partial_outage" <%= c.status === 'partial_outage' ? 'selected' : '' %>>Partial</option>
<option value="major_outage" <%= c.status === 'major_outage' ? 'selected' : '' %>>Major</option>
<option value="under_maintenance" <%= c.status === 'under_maintenance' ? 'selected' : '' %>>Maint.</option>
</select>
</form>
<form action="/admin/components/<%= c.id %>?_method=DELETE" method="post" class="delete-form" onsubmit="return confirm('Delete this component?')">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<button type="submit" class="btn btn-sm btn-danger">Delete</button>
</form>
</td>
</tr>
<% }) %>
<tr id="componentNoMatch" class="no-match-row" hidden><td colspan="8" class="empty-cell">No components match your search.</td></tr>
<% } %>
</tbody>
</table>
</div>
<% } %>

<% if (componentMode === 'create' || componentMode === 'edit') { %>
<div class="card">
<h3><%= componentMode === 'create' ? 'Create New Component' : 'Edit Component' %></h3>
<form action="<%= componentMode === 'create' ? '/admin/components' : '/admin/components/' + component.id %>" method="post">
<% if (componentMode === 'edit') { %>
<input type="hidden" name="_method" value="PUT">
<% } %>
<div class="form-group">
<label for="name">Name</label>
<input type="text" id="name" name="name" value="<%= component.name || '' %>" required>
</div>
<div class="form-group">
<label for="external_id">External ID</label>
<input type="text" id="external_id" name="external_id" value="<%= component.external_id || '' %>" placeholder="ID from external system (PRTG, Nagios, etc.)">
<small class="text-muted">Used to link components in StatusFe with external monitoring systems.</small>
</div>
<div class="form-row">
<div class="form-group">
<label>Groups (select one or more)</label>
<% if (groups && groups.length > 0) { %>
<input type="text" id="compGroupFilter" class="filter-input" placeholder="Type to search groups...">
<% } %>
<div style="max-height: 180px; overflow-y: auto; border: 1px solid var(--border); border-radius: 6px; padding: 10px;" id="compGroupList">
<% if (groups && groups.length > 0) { groups.forEach(g => { %>
<label data-filter-row data-filter-text="<%= g.name %>" style="display: block; padding: 4px 0; cursor: pointer;">
<input type="checkbox" name="group_ids" value="<%= g.id %>" <%= (selectedGroupIds || []).includes(g.id) ? 'checked' : '' %>>
<%= g.name %>
</label>
<% }); %>
<div data-filter-empty style="display:none;" class="text-muted">No groups match your search.</div>
<% } else { %>
<small class="text-muted">No groups yet — type a name below to create one.</small>
<% } %>
</div>
<small class="text-muted">A component can belong to several groups; it will show up on every page that displays any of them.</small>
</div>
<div class="form-group">
<label for="new_group_name">New Group</label>
<input type="text" id="new_group_name" name="new_group_name" value="<%= (!component.group_id && !(selectedGroupIds || []).length) ? (component.group_name || '') : '' %>" placeholder="Infrastructure">
<small class="text-muted">Type a name to create (or reuse) a group and add this component to it. Combined with the checkboxes above.</small>
</div>
<div class="form-group">
<label for="position">Position</label>
<input type="number" id="position" name="position" value="<%= component.position || 0 %>" min="0">
</div>
</div>
<div class="form-group">
<label for="description">Description</label>
<textarea id="description" name="description" rows="2"><%= component.description || '' %></textarea>
</div>
<div class="form-group">
<label for="status">Status</label>
<select id="status" name="status">
<option value="operational" <%= component.status === 'operational' ? 'selected' : '' %>>Operational</option>
<option value="degraded_performance" <%= component.status === 'degraded_performance' ? 'selected' : '' %>>Degraded Performance</option>
<option value="partial_outage" <%= component.status === 'partial_outage' ? 'selected' : '' %>>Partial Outage</option>
<option value="major_outage" <%= component.status === 'major_outage' ? 'selected' : '' %>>Major Outage</option>
<option value="under_maintenance" <%= component.status === 'under_maintenance' ? 'selected' : '' %>>Under Maintenance</option>
</select>
</div>
<div class="form-actions">
<button type="submit" class="btn btn-primary"><%= componentMode === 'create' ? 'Create Component' : 'Save Changes' %></button>
<% if (componentMode === 'edit') { %>
<a href="/admin/components" class="btn">Cancel</a>
<% } %>
</div>
</form>
</div>
<% } %>

</main>
</div>
<script src="/js/admin.js"></script>

<%- include("../partials/_csrf"); %>
<script>
(function() {
  var token = document.getElementById('csrfToken');
  if (token) {
    var forms = document.querySelectorAll('form[method="post"]');
    for (var i = 0; i < forms.length; i++) {
      if (!forms[i].querySelector('input[name="_csrf"]')) {
        var input = document.createElement('input');
        input.type = 'hidden';
        input.name = '_csrf';
        input.value = token.value;
        forms[i].appendChild(input);
      }
    }
  }
  if (typeof sfBindFilter === 'function') {
    sfBindFilter('compGroupFilter', 'compGroupList');
  }

  /* ===== Component list: instant search + click-to-sort headers (no page reload) ===== */
  var table = document.getElementById('component-list-table');
  var tbody = table && table.tBodies[0];
  if (!tbody) return;

  var filterForm = document.getElementById('componentListFilter');
  var searchInput = document.getElementById('componentSearchInput');
  var searchClear = document.getElementById('componentSearchClear');
  var sortInput = document.getElementById('componentSortInput');
  var metaEl = document.getElementById('componentListMeta');
  var noMatchRow = document.getElementById('componentNoMatch');
  var allCb = document.getElementById('select-all-checkbox');
  var bulkBtn = document.getElementById('bulk-delete-btn');

  var rows = [].slice.call(tbody.querySelectorAll('tr.component-row'));
  var renderedCount = rows.length;
  /* the query the server already filtered for us */
  var serverQ = ((searchInput && searchInput.value) || '').trim().toLowerCase();
  var COL_KEY = { name: 'name', external_id: 'external', group: 'group', status: 'status', position: 'pos', created: 'ts' };

  function rowCheck(row) { return row.querySelector('input.component-row-check'); }
  function isVisible(row) { return row.style.display !== 'none'; }
  function visibleCount() {
    var n = 0;
    for (var i = 0; i < rows.length; i++) if (isVisible(rows[i])) n++;
    return n;
  }
  /* only visible rows are ever selectable/deletable */
  function checkedIds() {
    var ids = [];
    for (var i = 0; i < rows.length; i++) {
      var cb = rowCheck(rows[i]);
      if (cb && cb.checked && isVisible(rows[i])) ids.push(cb.value);
    }
    return ids;
  }
  function updateSelection() {
    if (!bulkBtn) return;
    var n = checkedIds().length;
    bulkBtn.disabled = n === 0;
    bulkBtn.title = n ? n + ' component(s) selected' : '';
  }
  function updateMeta() {
    if (!metaEl) return;
    var vis = visibleCount();
    var noun = renderedCount === 1 ? ' component' : ' components';
    metaEl.textContent = vis < renderedCount ? vis + ' of ' + renderedCount + noun : renderedCount + noun;
  }
  function applyFilter() {
    if (!searchInput) return;
    var q = searchInput.value.trim().toLowerCase();
    for (var i = 0; i < rows.length; i++) {
      var row = rows[i];
      var ok = !q || (row.getAttribute('data-search') || '').indexOf(q) !== -1;
      row.style.display = ok ? '' : 'none';
      if (!ok) {
        /* never delete rows the user cannot see */
        var cb = rowCheck(row);
        if (cb && cb.checked) cb.checked = false;
      }
    }
    if (noMatchRow) noMatchRow.hidden = !(q && visibleCount() === 0);
    if (searchClear) searchClear.hidden = !searchInput.value;
    updateMeta();
    updateSelection();
  }
  function buildUrl(sortValue) {
    var q = (searchInput && searchInput.value.trim()) || '';
    var parts = [];
    if (q) parts.push('q=' + encodeURIComponent(q));
    if (sortValue && sortValue !== 'position_ASC') parts.push('sort=' + sortValue);
    return location.pathname + (parts.length ? '?' + parts.join('&') : '');
  }
  function syncUrl() {
    if (!window.history || !history.replaceState) return;
    try { history.replaceState(null, '', buildUrl(sortInput ? sortInput.value : '')); } catch (e) {}
  }
  function markSort(col, dir) {
    if (sortInput) sortInput.value = col + '_' + dir;
    var ths = table.querySelectorAll('th.sortable');
    for (var i = 0; i < ths.length; i++) {
      var c = ths[i].getAttribute('data-col');
      var active = (c === col);
      if (ths[i].classList) ths[i].classList.toggle('sorted', active);
      ths[i].setAttribute('aria-sort', active ? (dir === 'ASC' ? 'ascending' : 'descending') : 'none');
      var arrow = ths[i].querySelector('.sort-arrow');
      if (arrow) arrow.textContent = active ? (dir === 'ASC' ? '↑' : '↓') : '↕';
      var link = ths[i].querySelector('a');
      if (link) {
        /* keep the no-JS fallback pointing at the opposite direction */
        var next = active ? (dir === 'ASC' ? 'DESC' : 'ASC') : (c === 'created' ? 'DESC' : 'ASC');
        link.setAttribute('href', buildUrl(c + '_' + next));
      }
    }
  }
  function sortRows(col, dir) {
    var key = COL_KEY[col];
    if (!key) return;
    var numeric = (key === 'pos' || key === 'ts');
    var sorted = rows.slice().sort(function(a, b) {
      var A = a.getAttribute('data-' + key) || '';
      var B = b.getAttribute('data-' + key) || '';
      var r;
      if (numeric) r = (parseFloat(A) || 0) - (parseFloat(B) || 0);
      else r = String(A).localeCompare(String(B), undefined, { sensitivity: 'base', numeric: true });
      if (r === 0) r = String(a.getAttribute('data-name') || '').localeCompare(String(b.getAttribute('data-name') || ''), undefined, { sensitivity: 'base' });
      return dir === 'DESC' ? -r : r;
    });
    var statics = [];
    for (var i = 0; i < tbody.children.length; i++) {
      var el = tbody.children[i];
      if ((' ' + el.className + ' ').indexOf(' component-row ') === -1) statics.push(el);
    }
    for (var j = 0; j < sorted.length; j++) tbody.appendChild(sorted[j]);
    for (var k = 0; k < statics.length; k++) tbody.appendChild(statics[k]);
    rows = sorted;
    markSort(col, dir);
    syncUrl();
  }

  /* clicking a header toggles its direction: A→Z ⇄ Z→A (no reload) */
  var ths = table.querySelectorAll('th.sortable');
  for (var t = 0; t < ths.length; t++) {
    ths[t].addEventListener('click', function(e) {
      var col = this.getAttribute('data-col');
      var cur = (sortInput && sortInput.value) || '';
      var m = /^(.*)_(ASC|DESC)$/.exec(cur);
      var dir = (m && m[1] === col) ? (m[2] === 'ASC' ? 'DESC' : 'ASC') : (col === 'created' ? 'DESC' : 'ASC');
      sortRows(col, dir);
      if (e.cancelable) e.preventDefault();
    });
  }

  /* Search: refine the rendered set in place. Only when the query is no longer an
     extension of the server-rendered one (i.e. it got shorter) do we re-ask the
     server, so results stay correct without reloading on every keystroke. */
  function submitSearch() { if (filterForm) filterForm.submit(); }
  function onSearchChange() {
    if (!searchInput) return;
    if (searchClear) searchClear.hidden = !searchInput.value;
    var v = searchInput.value.trim().toLowerCase();
    if (v.indexOf(serverQ) === 0) { applyFilter(); syncUrl(); }
    else submitSearch();
  }
  if (searchInput) {
    searchInput.addEventListener('input', onSearchChange);
    searchInput.addEventListener('keydown', function(e) {
      if (e.key === 'Enter') { e.preventDefault(); onSearchChange(); }
    });
  }
  if (searchClear) {
    searchClear.addEventListener('click', function() {
      if (searchInput) searchInput.value = '';
      if (serverQ) { submitSearch(); return; }
  /* Render <time> in the viewer's timezone (the server renders its own TZ);
     the datetime attribute keeps the absolute instant for sorting/machines. */
  function formatTimes() {
    var times = table.querySelectorAll('tr.component-row time[datetime]');
    var p = function(n) { return (n < 10 ? '0' : '') + n; };
    for (var i = 0; i < times.length; i++) {
      var d = new Date(times[i].getAttribute('datetime'));
      if (isNaN(d.getTime())) continue;
      times[i].textContent = d.getFullYear() + '-' + p(d.getMonth() + 1) + '-' + p(d.getDate()) +
        ' ' + p(d.getHours()) + ':' + p(d.getMinutes());
    }
  }

  applyFilter();
  formatTimes();
      syncUrl();
      if (searchInput) searchInput.focus();
    });
  }
  if (filterForm) {
    filterForm.addEventListener('submit', function(e) {
      var v = ((searchInput && searchInput.value) || '').trim().toLowerCase();
      if (v.indexOf(serverQ) === 0) { e.preventDefault(); applyFilter(); syncUrl(); }
    });
  }

  /* select-all and bulk delete only ever touch VISIBLE rows */
  if (allCb) {
    allCb.addEventListener('change', function() {
      for (var i = 0; i < rows.length; i++) {
        var cb = rowCheck(rows[i]);
        if (cb && isVisible(rows[i])) cb.checked = allCb.checked;
      }
      updateSelection();
    });
  }
  for (var r = 0; r < rows.length; r++) {
    var cb0 = rowCheck(rows[r]);
    if (cb0) cb0.addEventListener('change', updateSelection);
  }
  if (bulkBtn) {
    bulkBtn.addEventListener('click', function() {
      var ids = checkedIds();
      if (ids.length === 0) return;
      if (!window.confirm('Delete ' + ids.length + ' component(s)? This cannot be undone.')) return;
      /* Nested per-row delete forms forbid putting these inputs in a static
         form around the table — build the POST form dynamically instead. */
      var form = document.createElement('form');
      form.method = 'post';
      form.action = '/admin/components/bulk-delete';
      function addField(name, value) {
        var input = document.createElement('input');
        input.type = 'hidden';
        input.name = name;
        input.value = value;
        form.appendChild(input);
      }
      var tokenEl = document.getElementById('csrfToken');
      if (tokenEl) addField('_csrf', tokenEl.value);
      for (var j = 0; j < ids.length; j++) addField('component_ids', ids[j]);
      document.body.appendChild(form);
      form.submit();
    });
  }

  applyFilter();
  var initial = /^(.*)_(ASC|DESC)$/.exec((sortInput && sortInput.value) || '');
  if (initial && COL_KEY[initial[1]]) markSort(initial[1], initial[2]);
  updateSelection();
})();
</script>
</body>
</html>
