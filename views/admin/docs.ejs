<%# i18n (5.0.0): only the prose is translated. HTTP verbs, paths, JSON samples,
    field names, data-curl attributes and the curl examples are DATA and stay
    exactly as they are. %>
<% const tr = (typeof t === 'function') ? t : function (k) { return k; }; %>
<!-- API Key Selector (admin only) -->
<% if (user.role === 'admin') { %>
<div class="doc-key-selector">
<label><%= tr('docs.apiKeyLabel') %></label>
<% if (keys && keys.length > 0) { %>
<select id="apiKeySelect" onchange="onKeyChange()">
<option value="__custom__"><%= tr('docs.pasteKeyOption') %></option>
<% keys.forEach(function(k) { %>
<option value="__custom__"><%= tr('docs.pasteKeyOptionNamed', { name: k.name, prefix: k.key_prefix }) %></option>
<% }); %>
</select>
<% } %>
<input type="text" id="customApiKey" placeholder="<%= tr('docs.keyPlaceholder') %>" oninput="onCustomKeyChange()">
<div class="doc-key-hint"><%= tr('docs.keyHint') %></div>
</div>
<% } %>

<!-- Tab Navigation -->
<div class="doc-tabs">
<button class="doc-tab-btn active" onclick="showTab('auth', this)"><%= tr('docs.tabAuth') %></button>
<button class="doc-tab-btn" onclick="showTab('info', this)"><%= tr('docs.tabInfo') %></button>
<button class="doc-tab-btn" onclick="showTab('pages', this)"><%= tr('nav.pages') %></button>
