<p class="doc-desc"><code data-curl="url">url</code> (<%= tr('docs.required') %>) — <code data-curl="events">events</code> — <code data-curl="secret">secret</code></p>
<p class="doc-desc"><%= tr('docs.events') %> <code data-curl="status.updated">status.updated</code>, <code data-curl="incident.created">incident.created</code>, <code data-curl="incident.updated">incident.updated</code>, <code data-curl="incident.deleted">incident.deleted</code>, <code data-curl="component.assigned">component.assigned</code></p>
