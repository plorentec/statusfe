<%# i18n (5.0.0): every user-visible string goes through `t` (res.locals). The
    fallback keeps standalone rendering working when a harness renders the
    template without the session middleware. %>
<% const tr = (typeof t === 'function') ? t : function (k) { return k; }; %>
<% const pt = (typeof pageTitle === 'function') ? pageTitle : function (x) { return x; }; %>
<% const loc = (typeof locale === 'string' && locale) ? locale : 'en'; %>
<!DOCTYPE html>
<html lang="<%= loc %>">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= pt(title) %> - <%= tr('common.adminTitle') %></title>
<link rel="stylesheet" href="/css/admin.css">
<script>document.addEventListener('DOMContentLoaded',function(){document.body.classList.add('dark');});</script>
</head>
<body>
<div class="admin-layout">
<%- include('../partials/_sidebar'); %>
<main class="admin-main">
<div class="admin-header"><h1><%= pt(title) %></h1>
<% if (message) { %>
<div class="flash flash-<%= messageType %>"><%= message %></div>
<% } %>
</div>

<div class="card">
<h3 style="font-size:16px;font-weight:600;margin-bottom:16px;padding-bottom:12px;border-bottom:1px solid var(--border);"><%= tr('deps.add') %></h3>
<form action="/admin/dependencies" method="post">
<div class="form-row">
<div class="form-group">
<label for="component_id"><%= tr('deps.componentLabel') %></label>
<select id="component_id" name="component_id" required>
<option value=""><%= tr('deps.selectComponent') %></option>
<% components.forEach(c => { %>
<option value="<%= c.id %>"><%= c.name %></option>
<% }) %>
</select>
</div>
<div class="form-group">
<label for="depends_on"><%= tr('deps.dependsOnLabel') %></label>
<select id="depends_on" name="depends_on" required>
<option value=""><%= tr('deps.selectComponent') %></option>
<% components.forEach(c => { %>
<option value="<%= c.id %>"><%= c.name %></option>
<% }) %>
</select>
</div>
</div>
<div class="form-group checkbox-group">
<label>
<input type="checkbox" id="cascade_status" name="cascade_status" checked>
<%= tr('deps.cascadeLabel') %>
</label>
</div>
<div class="form-actions">
<button type="submit" class="btn btn-primary"><%= tr('deps.add') %></button>
</div>
</form>
<p class="text-muted" style="margin-top:8px;"><%= tr('deps.helpLine1') %><br><%= tr('deps.helpLine2Prefix') %> <em><%= tr('deps.exampleDb') %></em>.</p>
</div>

<% if (hubGroups && hubGroups.length > 0) { %>
<% hubGroups.forEach(group => { %>
<div class="card" style="margin-top:20px;">
<h3 style="font-size:16px;font-weight:600;margin-bottom:16px;padding-bottom:12px;border-bottom:1px solid var(--border);">
<i class="dot dot-operational" style="display:inline-block;width:10px;height:10px;border-radius:50%;margin-right:8px;"></i>
<strong><%= group.name %></strong> <span class="text-muted" style="font-size:13px;">— <%= group.dependents.length %> <%= tr(group.dependents.length !== 1 ? 'deps.dependentMany' : 'deps.dependentOne') %></span>
</h3>
<div class="table-container">
<table class="admin-table">
<thead>
<tr><th><%= tr('deps.thDependent') %></th><th><%= tr('deps.thCascade') %></th><th><%= tr('components.thActions') %></th></tr>
</thead>
<tbody>
<% group.dependents.forEach(d => { %>
<tr>
<td><strong><%= d.name %></strong></td>
<td><span class="<%= d.cascade ? 'yes' : 'no' %>"><%= d.cascade ? tr('common.yes') : tr('common.no') %></span></td>
<td class="actions">
<form action="/admin/dependencies/<%= d.id %>?_method=DELETE" method="post" class="delete-form">
<button type="submit" class="btn btn-sm btn-danger"><%= tr('subs.remove') %></button>
</form>
</td>
</tr>
<% }) %>
</tbody>
</table>
</div>
</div>
<% }) %>
<% } else { %>
<div class="card" style="margin-top:20px;"><p class="text-muted"><%= tr('deps.none') %></p></div>
<% } %>
</main>
</div>
<script src="/js/admin.js"></script>
<%- include("../partials/_csrf"); %>
<script>
(function() {
  var token = document.getElementById('csrfToken');
  if (token) {
    var forms = document.querySelectorAll('form[method="post"]');
    for (var i = 0; i < forms.length; i++) {
      if (!forms[i].querySelector('input[name="_csrf"]')) {
        var input = document.createElement('input');
        input.type = 'hidden';
        input.name = '_csrf';
        input.value = token.value;
        forms[i].appendChild(input);
      }
    }
  }
})();
</script>
</body>
</html>
