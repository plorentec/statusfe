<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title %> - StatusFe</title>
<link rel="stylesheet" href="/css/admin.css">
<script>document.addEventListener('DOMContentLoaded',function(){document.body.classList.add('dark');});</script>
</head>
<body>
<div class="auth-container">
<div class="auth-card">
<div class="auth-header">
<h1>StatusFe</h1>
<p><%= (typeof mustChange !== 'undefined' && mustChange) ? 'Set a new password to finish signing in' : 'Change your password' %></p>
</div>
<% if (typeof mustChange !== 'undefined' && mustChange) { %>
<div class="flash flash-success">This account still uses the password generated at first boot. Choose your own password to unlock the panel.</div>
<% } %>
<% if (error) { %>
<div class="flash flash-error"><%= error %></div>
<% } %>
<form action="/auth/change-password" method="post" class="auth-form">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<div class="form-group">
<label for="current_password">Current password</label>
<input type="password" id="current_password" name="current_password" required autofocus autocomplete="current-password" placeholder="The password you signed in with">
</div>
<div class="form-group">
<label for="password">New password</label>
<input type="password" id="password" name="password" required minlength="8" autocomplete="new-password" placeholder="At least 8 characters">
</div>
<div class="form-group">
<label for="confirm_password">Confirm new password</label>
<input type="password" id="confirm_password" name="confirm_password" required minlength="8" autocomplete="new-password" placeholder="Repeat the new password">
</div>
<button type="submit" class="btn btn-primary btn-full">Set New Password</button>
</form>
<p class="auth-footer"><a href="/auth/logout" onclick="event.preventDefault();document.getElementById('logout-form').submit();">Sign out</a></p>
<form id="logout-form" action="/auth/logout" method="post" style="display:none;"></form>
</div>
</div>
</body>
</html>
